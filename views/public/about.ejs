<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/"><%= t('crumb.home') %></a> / <%= t('nav.about') %></div>
    <h1><%= about ? about.title : t('about.title') %></h1>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="grid g2" style="gap:3rem;align-items:start">
      <div class="prose">
        <% if (about) { %><p><%= about.body %></p><% } %>
        <% if (mission) { %>
          <h2><%= mission.title %></h2>
          <p><%= mission.body %></p>
        <% } %>
        <% if (facilities) { %>
          <h2><%= facilities.title %></h2>
          <p><%= facilities.body %></p>
        <% } %>
      </div>
      <aside>
        <div class="card" style="margin-bottom:1.2rem">
          <h3><%= t('about.at_a_glance') %></h3>
          <table class="data" style="font-size:.9rem">
            <tr><th><%= t('common.established') %></th><td><%= settings.established || '—' %></td></tr>
            <tr><th><%= t('common.location') %></th><td><%= site.address || '—' %></td></tr>
            <tr><th><%= t('common.phone') %></th><td><%= site.phone || '—' %></td></tr>
            <tr><th><%= t('common.email') %></th><td><%= site.email || '—' %></td></tr>
          </table>
        </div>
        <div class="card">
          <h3><%= t('footer.admission') %></h3>
          <p><%= t('about.admission_note') %></p>
          <a class="btn btn-green btn-sm" href="/admission" style="margin-top:.6rem"><%= t('about.apply_now') %></a>
        </div>
      </aside>
    </div>
  </div>
</section>

<% if (leaders && leaders.length) { %>
<section class="alt">
  <div class="wrap">
    <div class="section-head">
      <span class="kicker"><%= t('about.our_people') %></span>
      <h2><%= t('about.teachers_management') %></h2>
    </div>
    <div class="grid g3">
      <% leaders.forEach(function (p) { %>
        <div class="card" style="text-align:center">
          <div style="width:64px;height:64px;margin:0 auto .8rem;border-radius:50%;background:var(--green-700);color:#fff;display:grid;place-items:center;font-family:var(--serif);font-size:1.5rem"><%= p.name.charAt(0) %></div>
          <h3 style="font-size:1.05rem;margin-bottom:.15rem"><%= p.name %></h3>
          <p style="color:var(--green-700);font-weight:600;font-size:.86rem;margin-bottom:.3rem"><%= p.designation || '' %></p>
          <p style="font-size:.85rem"><%= p.qualification || '' %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

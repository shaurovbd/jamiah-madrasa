              <%- field({ name:'full_name_en', bn:'শিক্ষার্থীর নাম (ইংরেজি)', en:'Full Name (English)' }) %>
              <%- field({ name:'dob', bn:'জন্ম তারিখ', en:'Date of Birth', type:'date', req:true }) %>
              <%- field({ name:'gender', bn:'লিঙ্গ', en:'Gender', type:'select',
                          options:[{ value:'', label:'নির্বাচন করুন' }].concat(af.GENDERS.map(function (g) { return { value:g.value, label:g.label }; })) }) %>
              <%- field({ name:'nationality', bn:'জাতীয়তা', en:'Nationality', value:'বাংলাদেশী' }) %>
              <%- field({ name:'student_mobile', bn:'শিক্ষার্থীর মোবাইল', en:'Student Mobile', type:'tel', placeholder:'+880 1XXX-XXXXXX' }) %>
              <%- field({ name:'email', bn:'ইমেইল', en:'Email', type:'email', req:true, full:true, placeholder:'you@example.com', msg:'ইমেইল ঠিকানা দিন। / Please enter your email address.', msgType:'সঠিক ইমেইল ঠিকানা দিন, যেমন you@example.com / Enter a valid email address, e.g. you@example.com' }) %>
            </div>
          </div>
        </div>

        <!-- ------------------------------- 2. department & campus -->
        <div class="ja-step" data-step="1">
          <div class="ja-section">
            <%- sectionHead('layers', 'বিভাগ নির্বাচন করুন', 'Select Department') %>
            <div class="ja-choice-grid">
              <% af.DEPARTMENTS.forEach(function (d) { %>
                <label class="ja-choice">
                  <input type="radio" name="department" value="<%= d.key %>" <%= form.department === d.key ? 'checked' : '' %> required>
                  <span class="ja-choice-body">
                    <span class="ja-choice-icon"><%- icons[d.icon] %></span>
                    <span class="ja-choice-title"><%= d.title %></span>
                    <ul class="ja-choice-list">
                      <% d.items.forEach(function (it) { %><li class="ja-choice-item"><%= it %></li><% }); %>
                    </ul>
                  </span>
                </label>
              <% }); %>
            </div>
          </div>

          <div class="ja-section ja-section--gold">
            <%- sectionHead('pin', 'ক্যাম্পাস নির্বাচন করুন', 'Select Campus') %>
            <div class="ja-choice-grid ja-choice-grid--campus">
              <% af.CAMPUSES.forEach(function (c) { %>
                <label class="ja-choice ja-choice--campus">
                  <input type="radio" name="campus" value="<%= c.key %>" <%= form.campus === c.key ? 'checked' : '' %> required>
                  <span class="ja-choice-body">
                    <span class="ja-choice-icon"><%- icons.pin %></span>
                    <span class="ja-choice-title"><%= c.title %></span>
                    <p class="ja-choice-desc"><%= c.desc %></p>
                  </span>
                </label>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- -------------------------------------------- 3. parents -->
        <div class="ja-step" data-step="2">
          <div class="ja-section">
            <%- sectionHead('users', 'পিতা-মাতার তথ্য', 'Parents Information') %>
            <div class="ja-grid">
              <%- field({ name:'father_name', bn:'পিতার নাম', en:"Father's Name", req:true }) %>
              <%- field({ name:'father_mobile', bn:'পিতার মোবাইল', en:"Father's Mobile", type:'tel', req:true, placeholder:'+880 1XXX-XXXXXX' }) %>
              <%- field({ name:'father_profession', bn:'পিতার পেশা', en:"Father's Profession" }) %>
              <%- field({ name:'father_income', bn:'মাসিক আয়', en:'Monthly Income' }) %>
              <%- field({ name:'mother_name', bn:'মাতার নাম', en:"Mother's Name" }) %>
              <%- field({ name:'mother_mobile', bn:'মাতার মোবাইল', en:"Mother's Mobile", type:'tel', placeholder:'+880 1XXX-XXXXXX' }) %>
            </div>
          </div>
        </div>

        <!-- ------------------------------------------- 4. guardian -->
        <div class="ja-step" data-step="3">
          <div class="ja-section">

<%
/* ---------------------------------------------------------------- icons */
const icons = {
  user:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  layers:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 17 9 5 9-5"/><path d="m3 12 9 5 9-5"/></svg>',
  pin:     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>',
  users:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  shield:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>',
  home:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>',
  cap:     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/></svg>',
  book:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>',
  globe:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"/></svg>',
  scroll:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h11v14a4 4 0 0 1-4 4H7"/><path d="M8 3a3 3 0 0 0-3 3v2h3"/><path d="M5 17a4 4 0 0 0 4 4"/><path d="M11 8h5"/><path d="M11 12h5"/></svg>',
  child:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="3"/><path d="M12 9v6"/><path d="m8 12 4-1 4 1"/><path d="m9 21 3-6 3 6"/></svg>',
  star:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.3-6.2 3.3L7 14.2l-5-4.9 6.9-1L12 2Z"/></svg>',
  monitor: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>'
};

/* ------------------------------------------------- one labelled field */
function field(o) {
  const name = o.name;
  const id = 'ja_' + name;
  const val = h.esc(form[name] == null ? (o.value || '') : form[name]);
  const req = o.req ? ' <span class="ja-req">*</span>' : '';
  const reqAttr = o.req ? ' required' : '';
  const ph = o.placeholder ? ' placeholder="' + h.esc(o.placeholder) + '"' : '';
  const msgAttr = (o.msg ? ' data-msg="' + h.esc(o.msg) + '"' : '')
                + (o.msgType ? ' data-msg-type="' + h.esc(o.msgType) + '"' : '');
  let control;

  if (o.type === 'textarea') {
    control = '<textarea id="' + id + '" name="' + name + '"' + ph + reqAttr + msgAttr + '>' + val + '</textarea>';
  } else if (o.type === 'select') {
    const opts = (o.options || []).map(function (op) {
      const sel = String(form[name] || '') === String(op.value) ? ' selected' : '';
      return '<option value="' + h.esc(op.value) + '"' + sel + '>' + h.esc(op.label) + '</option>';
    }).join('');
    control = '<select id="' + id + '" name="' + name + '"' + reqAttr + msgAttr + '>' + opts + '</select>';
  } else {
    control = '<input id="' + id + '" name="' + name + '" type="' + (o.type || 'text') + '"'
            + ' value="' + val + '"' + ph + reqAttr + msgAttr + '>';
  }

  // One label, in the reader's language. The form used to stack Bangla over
  // English; the header toggle now decides, so a second line would just repeat
  // the question in the language the reader did not pick.
  return '<div class="ja-field' + (o.full ? ' ja-field--full' : '') + '">'
       + '<label for="' + id + '">' + h.esc(o.label) + req + '</label>'
       + control + '</div>';
}

/* --------------------------------------------------- one section header */
function sectionHead(icon, label) {
  return '<div class="ja-section-head">'
       + '<span class="ja-section-icon">' + icons[icon] + '</span>'
       + '<span><span class="ja-section-title">' + h.esc(label) + '</span></span></div>';
}

/* The departments, campuses, steps and gender options with one language
   already resolved, so the markup below never has to branch on `lang`. */
const L = af.forLang(lang);
%>

<!-- "layout extractStyles" in app.js hoists these into <head><meta charset="utf-8">, so they load
     on /admission only rather than on every page of the site. -->
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admission.css">

<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/"><%= t('crumb.home') %></a> / <%= t('admission.crumb') %></div>
    <h1><%= t('admission.title') %></h1>
  </div>
</div>

<section>
  <div class="wrap">

  <% if (submitted) { %>
    <div class="ja-wrap">
      <div class="ja-done">
        <div class="ja-done-mark">✓</div>
        <h2><%= t('admission.received_title') %></h2>
        <p><%- t('admission.received_thanks', { name: '<strong>' + h.esc(submitted.name) + '</strong>' }) %></p>
        <p class="ja-done-no">
          <small><%= t('admission.app_number') %></small>
          <strong><%= submitted.applicationNo %></strong>
        </p>
        <p style="color:var(--ja-muted);font-size:.93rem">
          <%= t('admission.keep_number') %>
        </p>
        <p style="margin-top:1.4rem"><a class="btn btn-green" href="/"><%= t('admission.back_home') %></a></p>
      </div>
    </div>

  <% } else { %>
    <div class="ja-wrap">

      <div class="ja-head">
        <h2><%= t('admission.form_title') %></h2>
        <p><%= t('admission.fill_hint') %> <span class="ja-req">*</span> <%= t('admission.fill_hint_tail') %></p>
      </div>

      <% if (errors && errors.length) { %>
        <div class="ja-errors" role="alert">
          <%# validate() hands back translation keys, not finished sentences. %>
          <ul><% errors.forEach(function (e) { %><li><%= t(e) %></li><% }); %></ul>
        </div>
      <% } %>

      <div class="ja-stepper">
        <div class="ja-stepper-track">
          <div class="ja-stepper-line"></div>
          <div class="ja-stepper-fill" id="jaStepperFill"></div>
          <ol class="ja-stepper-list">
            <% L.STEPS.forEach(function (s, i) { %>
              <li class="ja-stepper-item<%= i === 0 ? ' is-active' : '' %>" data-step="<%= i %>">
                <span class="ja-stepper-dot"><%= s.n %></span>
                <span class="ja-stepper-label"><%= s.label %></span>
              </li>
            <% }); %>
          </ol>
        </div>
        <p class="ja-stepper-caption" id="jaCaption"><%= t('admission.step') %> <%= L.STEPS[0].n %> / <%= L.STEPS[L.STEPS.length - 1].n %> · <%= L.STEPS[0].label %></p>
      </div>

      <form method="post" action="/admission" id="jamiah-admission-form" class="ja-form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="ja-honeypot" aria-hidden="true">
          <label for="ja_website">Website</label>
          <input id="ja_website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>

        <!-- ------------------------------------------- 1. student -->
        <div class="ja-step is-active" data-step="0">
          <div class="ja-section">
            <%- sectionHead('user', t('admission.sec.student')) %>
            <div class="ja-grid">
              <%- field({ name:'full_name_bn', label:t('admission.f.name_bn'), req:true }) %>
              <%- field({ name:'full_name_en', label:t('admission.f.name_en') }) %>
              <%- field({ name:'dob', label:t('admission.f.dob'), type:'date', req:true }) %>
              <%- field({ name:'gender', label:t('admission.f.gender'), type:'select',
                          options:[{ value:'', label:t('common.select') }].concat(L.GENDERS) }) %>
              <%- field({ name:'nationality', label:t('admission.f.nationality'), value:t('admission.f.nationality_value') }) %>
              <%- field({ name:'student_mobile', label:t('admission.f.student_mobile'), type:'tel', placeholder:'+880 1XXX-XXXXXX' }) %>
              <%- field({ name:'email', label:t('common.email'), type:'email', req:true, full:true, placeholder:'you@example.com', msg:t('admission.err.email'), msgType:t('admission.err.email_type') }) %>
            </div>
          </div>
        </div>

        <!-- ------------------------------- 2. department & campus -->
        <div class="ja-step" data-step="1">
          <div class="ja-section">
            <%- sectionHead('layers', t('admission.sec.department')) %>
            <div class="ja-choice-grid">
              <% L.DEPARTMENTS.forEach(function (d) { %>
                <label class="ja-choice">
                  <input type="radio" name="department" value="<%= d.key %>" <%= form.department === d.key ? 'checked' : '' %> required>
                  <span class="ja-choice-body">
                    <span class="ja-choice-icon"><%- icons[d.icon] %></span>
                    <span class="ja-choice-title"><%= d.title %></span>
                    <ul class="ja-choice-list">
                      <% d.items.forEach(function (it) { %><li class="ja-choice-item"><%= it %></li><% }); %>
                    </ul>
                  </span>
                </label>
              <% }); %>
            </div>
          </div>

          <div class="ja-section ja-section--gold">
            <%- sectionHead('pin', t('admission.sec.campus')) %>
            <div class="ja-choice-grid ja-choice-grid--campus">
              <% L.CAMPUSES.forEach(function (c) { %>
                <label class="ja-choice ja-choice--campus">
                  <input type="radio" name="campus" value="<%= c.key %>" <%= form.campus === c.key ? 'checked' : '' %> required>
                  <span class="ja-choice-body">
                    <span class="ja-choice-icon"><%- icons.pin %></span>
                    <span class="ja-choice-title"><%= c.title %></span>
                    <p class="ja-choice-desc"><%= c.desc %></p>
                  </span>
                </label>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- -------------------------------------------- 3. parents -->
        <div class="ja-step" data-step="2">
          <div class="ja-section">
            <%- sectionHead('users', t('admission.sec.parents')) %>
            <div class="ja-grid">
              <%- field({ name:'father_name', label:t('admission.f.father_name'), req:true }) %>
              <%- field({ name:'father_mobile', label:t('admission.f.father_mobile'), type:'tel', req:true, placeholder:'+880 1XXX-XXXXXX' }) %>
              <%- field({ name:'father_profession', label:t('admission.f.father_profession') }) %>
              <%- field({ name:'father_income', label:t('admission.f.father_income') }) %>
              <%- field({ name:'mother_name', label:t('admission.f.mother_name') }) %>
              <%- field({ name:'mother_mobile', label:t('admission.f.mother_mobile'), type:'tel', placeholder:'+880 1XXX-XXXXXX' }) %>
            </div>
          </div>
        </div>

        <!-- ------------------------------------------- 4. guardian -->
        <div class="ja-step" data-step="3">
          <div class="ja-section">
            <%- sectionHead('shield', t('admission.sec.guardian')) %>
            <div class="ja-grid">
              <%- field({ name:'guardian_name', label:t('admission.f.guardian_name') }) %>
              <%- field({ name:'guardian_relation', label:t('admission.f.guardian_relation') }) %>
              <%- field({ name:'guardian_mobile', label:t('admission.f.guardian_mobile'), type:'tel', placeholder:'+880 1XXX-XXXXXX' }) %>
              <%- field({ name:'guardian_address', label:t('admission.f.guardian_address'), type:'textarea', full:true }) %>
            </div>
          </div>
        </div>

        <!-- -------------------------------------------- 5. address -->
        <div class="ja-step" data-step="4">
          <div class="ja-section">
            <%- sectionHead('home', t('admission.sec.present_address')) %>
            <div class="ja-grid">
              <%- field({ name:'present_house', label:t('admission.f.house') }) %>
              <%- field({ name:'present_moholla', label:t('admission.f.moholla') }) %>
              <%- field({ name:'present_thana', label:t('admission.f.thana') }) %>
              <%- field({ name:'present_district', label:t('admission.f.district') }) %>
            </div>
          </div>

          <div class="ja-section ja-section--gold">
            <%- sectionHead('pin', t('admission.sec.permanent_address')) %>
            <p style="margin:-.6rem 0 1rem">
              <label style="font-size:.9rem;color:var(--ja-muted);display:inline-flex;align-items:center;gap:.45rem;cursor:pointer">
                <input type="checkbox" id="jaSameAddress" style="width:auto;margin:0"> <%= t('admission.f.same_address') %>
              </label>
            </p>
            <div class="ja-grid">
              <%- field({ name:'permanent_village', label:t('admission.f.village') }) %>
              <%- field({ name:'permanent_post', label:t('admission.f.post') }) %>
              <%- field({ name:'permanent_thana', label:t('admission.f.thana') }) %>
              <%- field({ name:'permanent_district', label:t('admission.f.district') }) %>
            </div>
          </div>
        </div>

        <!-- ------------------------------------------- 6. academic -->
        <div class="ja-step" data-step="5">
          <div class="ja-section">
            <%- sectionHead('cap', t('admission.sec.academic')) %>
            <div class="ja-grid">
              <%- field({ name:'prev_inst_name', label:t('admission.f.prev_inst'), full:true }) %>
              <%- field({ name:'prev_class', label:t('admission.f.prev_class') }) %>
              <%- field({ name:'target_class', label:t('admission.f.target_class') }) %>
            </div>
          </div>
        </div>

        <div class="ja-stepnav">
          <button type="button" class="ja-navbtn ja-navbtn--prev" id="jaPrev" disabled>← <%= t('admission.prev') %></button>
          <span class="ja-stepnav-count" id="jaCount"><%= t('admission.step') %> <%= L.STEPS[0].n %> / <%= L.STEPS[L.STEPS.length - 1].n %></span>
          <button type="button" class="ja-navbtn ja-navbtn--next" id="jaNext"><%= t('admission.next') %> →</button>
        </div>

        <div class="ja-actions" id="jaActions" hidden>
          <button type="submit" class="ja-submit" id="jaSubmit"><%= t('admission.submit') %></button>
          <p class="ja-actions-note"><%= t('admission.submit_note') %></p>
        </div>
      </form>
    </div>
  <% } %>

    <div class="grid g2" style="gap:1.6rem;align-items:start;margin-top:3rem">
      <div class="card">
        <h3><%= t('admission.how.title') %></h3>
        <ol style="padding-left:1.1rem;font-size:.92rem;color:var(--muted)">
          <li style="margin-bottom:.5rem"><%= t('admission.how.1') %></li>
          <li style="margin-bottom:.5rem"><%= t('admission.how.2') %></li>
          <li style="margin-bottom:.5rem"><%= t('admission.how.3') %></li>
          <li><%= t('admission.how.4') %></li>
        </ol>
      </div>
      <% if (feeHeads && feeHeads.length) { %>
      <div class="card">
        <h3><%= t('admission.fees.title') %></h3>
        <table class="data" style="font-size:.88rem">
          <thead><tr><th><%= t('admission.fees.head') %></th><th><%= t('common.type') %></th><th style="text-align:right"><%= t('common.amount') %></th></tr></thead>
          <tbody>
            <% feeHeads.forEach(function (f) { %>
              <tr>
                <td><%= f.name %></td>
                <td><%= label('ftype', f.ftype) %></td>
                <td style="text-align:right"><%= currency %> <%= Number(f.amount).toLocaleString('en-US') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <p class="hint" style="margin-top:.7rem"><%= t('admission.fees.note') %></p>
      </div>
      <% } %>
    </div>

  </div>
</section>

<script>
(function () {
  var form = document.getElementById('jamiah-admission-form');
  if (!form) return;

  // Numerals, labels and the word "Step" all come from the server in the
  // active language, so the stepper caption matches the rest of the page.
  var NUMS = <%- JSON.stringify(L.STEPS.map(function (s) { return s.n; })) %>;
  var LABELS = <%- JSON.stringify(L.STEPS.map(function (s) { return s.label; })) %>;
  var STEP_WORD = <%- JSON.stringify(t('admission.step')) %>;
  var SUBMITTING = <%- JSON.stringify(t('admission.submitting')) %>;

  var steps   = [].slice.call(form.querySelectorAll('.ja-step'));
  var dots    = [].slice.call(document.querySelectorAll('.ja-stepper-item'));
  var fill    = document.getElementById('jaStepperFill');
  var caption = document.getElementById('jaCaption');
  var count   = document.getElementById('jaCount');
  var prevBtn = document.getElementById('jaPrev');
  var nextBtn = document.getElementById('jaNext');
  var actions = document.getElementById('jaActions');
  var current = 0;

  function show(i) {
    current = Math.max(0, Math.min(steps.length - 1, i));
    steps.forEach(function (s, n) { s.classList.toggle('is-active', n === current); });
    dots.forEach(function (d, n) {
      d.classList.toggle('is-active', n === current);
      d.classList.toggle('is-done', n < current);
    });
    fill.style.width = (current / (steps.length - 1) * 100) + '%';
    caption.textContent = STEP_WORD + ' ' + NUMS[current] + ' / ' + NUMS[steps.length - 1] + ' · ' + LABELS[current];
    count.textContent = STEP_WORD + ' ' + NUMS[current] + ' / ' + NUMS[steps.length - 1];
    prevBtn.disabled = current === 0;
    nextBtn.hidden = current === steps.length - 1;
    actions.hidden = current !== steps.length - 1;
  }

  /* Validates only the fields on the step being left, so an applicant is
     never blocked by a field they have not reached yet. */
  function stepIsValid(i) {
    var fields = [].slice.call(steps[i].querySelectorAll('input, select, textarea'));
    var ok = true;
    var firstBad = null;
    var seenRadio = {};

    fields.forEach(function (el) {
      el.classList.remove('is-invalid');
      if (el.setCustomValidity) el.setCustomValidity('');
      if (!el.required) return;

      if (el.type === 'radio') {
        if (seenRadio[el.name]) return;
        seenRadio[el.name] = true;
        if (!form.querySelector('input[name="' + el.name + '"]:checked')) {
          ok = false;
          if (!firstBad) firstBad = el.closest('.ja-choice-grid') || el;
        }
        return;
      }

      if (!el.checkValidity()) {
        ok = false;
        el.classList.add('is-invalid');
        var jaMsg = el.validity.valueMissing
          ? el.getAttribute('data-msg')
          : (el.validity.typeMismatch || el.validity.patternMismatch)
            ? (el.getAttribute('data-msg-type') || el.getAttribute('data-msg'))
            : '';
        if (jaMsg && el.setCustomValidity) el.setCustomValidity(jaMsg);
        if (!firstBad) firstBad = el;
      }
    });

    if (!ok && firstBad) {
      firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (firstBad.focus) { try { firstBad.focus({ preventScroll: true }); } catch (e) {} }
      if (firstBad.reportValidity) { try { firstBad.reportValidity(); } catch (e) {} }
    }
    return ok;
  }

  nextBtn.addEventListener('click', function () {
    if (!stepIsValid(current)) return;
    show(current + 1);
    document.querySelector('.ja-stepper').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  prevBtn.addEventListener('click', function () {
    show(current - 1);
    document.querySelector('.ja-stepper').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* Let a visitor jump back to any step they have already completed. */
  dots.forEach(function (d, n) {
    d.style.cursor = 'pointer';
    d.addEventListener('click', function () {
      if (n < current) show(n);
      else if (n > current && stepIsValid(current)) show(current + 1);
    });
  });

  /* Clear a custom validation message as soon as the visitor edits the field. */
  document.addEventListener('input', function (e) {
    var el = e.target;
    if (el && el.setCustomValidity) { el.setCustomValidity(''); el.classList.remove('is-invalid'); }
  });

  /* "Same as present address" copies the four present-address boxes. */
  var same = document.getElementById('jaSameAddress');
  if (same) {
    var PAIRS = [
      ['ja_present_house', 'ja_permanent_village'],
      ['ja_present_moholla', 'ja_permanent_post'],
      ['ja_present_thana', 'ja_permanent_thana'],
      ['ja_present_district', 'ja_permanent_district']
    ];
    same.addEventListener('change', function () {
      if (!same.checked) return;
      PAIRS.forEach(function (p) {
        var from = document.getElementById(p[0]);
        var to = document.getElementById(p[1]);
        if (from && to) to.value = from.value;
      });
    });
  }

  form.addEventListener('submit', function (e) {
    for (var i = 0; i < steps.length; i += 1) {
      if (!stepIsValid(i)) {
        e.preventDefault();
        show(i);
        return;
      }
    }
    var btn = document.getElementById('jaSubmit');
    if (btn) { btn.disabled = true; btn.textContent = SUBMITTING; }
  });

  show(0);
})();
</script>

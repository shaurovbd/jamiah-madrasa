<%
/* ---------------------------------------------------------------- icons */
const icons = {
  user:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  layers:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 17 9 5 9-5"/><path d="m3 12 9 5 9-5"/></svg>',
  pin:     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>',
  users:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  shield:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>',
  home:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>',
  cap:     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/></svg>',
  book:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>',
  globe:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"/></svg>',
  scroll:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h11v14a4 4 0 0 1-4 4H7"/><path d="M8 3a3 3 0 0 0-3 3v2h3"/><path d="M5 17a4 4 0 0 0 4 4"/><path d="M11 8h5"/><path d="M11 12h5"/></svg>',
  child:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="3"/><path d="M12 9v6"/><path d="m8 12 4-1 4 1"/><path d="m9 21 3-6 3 6"/></svg>',
  star:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.3-6.2 3.3L7 14.2l-5-4.9 6.9-1L12 2Z"/></svg>',
  monitor: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>'
};

/* ------------------------------------------------- one labelled field */
function field(o) {
  const name = o.name;
  const id = 'ja_' + name;
  const val = h.esc(form[name] == null ? (o.value || '') : form[name]);
  const req = o.req ? ' <span class="ja-req">*</span>' : '';
  const reqAttr = o.req ? ' required' : '';
  const ph = o.placeholder ? ' placeholder="' + h.esc(o.placeholder) + '"' : '';
  const msgAttr = (o.msg ? ' data-msg="' + h.esc(o.msg) + '"' : '')
                + (o.msgType ? ' data-msg-type="' + h.esc(o.msgType) + '"' : '');
  let control;

  if (o.type === 'textarea') {
    control = '<textarea id="' + id + '" name="' + name + '"' + ph + reqAttr + msgAttr + '>' + val + '</textarea>';
  } else if (o.type === 'select') {
    const opts = (o.options || []).map(function (op) {
      const sel = String(form[name] || '') === String(op.value) ? ' selected' : '';
      return '<option value="' + h.esc(op.value) + '"' + sel + '>' + h.esc(op.label) + '</option>';
    }).join('');
    control = '<select id="' + id + '" name="' + name + '"' + reqAttr + msgAttr + '>' + opts + '</select>';
  } else {
    control = '<input id="' + id + '" name="' + name + '" type="' + (o.type || 'text') + '"'
            + ' value="' + val + '"' + ph + reqAttr + msgAttr + '>';
  }

  return '<div class="ja-field' + (o.full ? ' ja-field--full' : '') + '">'
       + '<label for="' + id + '">' + h.esc(o.bn)
       + '<span class="ja-label-en">' + h.esc(o.en) + '</span>' + req + '</label>'
       + control + '</div>';
}

/* --------------------------------------------------- one section header */
function sectionHead(icon, bn, en) {
  return '<div class="ja-section-head">'
       + '<span class="ja-section-icon">' + icons[icon] + '</span>'
       + '<span><span class="ja-section-title">' + h.esc(bn) + '</span>'
       + '<span class="ja-section-sub">' + h.esc(en) + '</span></span></div>';
}
%>

<!-- "layout extractStyles" in app.js hoists these into <head><meta charset="utf-8">, so they load
     on /admission only rather than on every page of the site. -->
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admission.css">

<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Admission</div>
    <h1>Online Admission</h1>
  </div>
</div>

<section>
  <div class="wrap">

  <% if (submitted) { %>
    <div class="ja-wrap">
      <div class="ja-done">
        <div class="ja-done-mark">✓</div>
        <h2>আবেদন গৃহীত হয়েছে</h2>
        <p>ধন্যবাদ, <strong><%= submitted.name %></strong>। আপনার ভর্তি আবেদনটি আমাদের কাছে জমা হয়েছে।</p>
        <p class="ja-done-no">
          <small>Application Number</small>
          <strong><%= submitted.applicationNo %></strong>
        </p>
        <p style="color:var(--ja-muted);font-size:.93rem">
          নম্বরটি সংরক্ষণ করে রাখুন। আমাদের ভর্তি অফিস আপনার দেওয়া মোবাইল নম্বরে যোগাযোগ করে
          সাক্ষাৎকারের সময় জানিয়ে দেবে, ইনশাআল্লাহ।
        </p>
        <p style="margin-top:1.4rem"><a class="btn btn-green" href="/">হোমে ফিরে যান</a></p>
      </div>
    </div>

  <% } else { %>
    <div class="ja-wrap">

      <div class="ja-head">
        <h2>ভর্তি আবেদন ফরম</h2>
        <p>নিচের তথ্যগুলো সঠিকভাবে পূরণ করুন। <span class="ja-req">*</span> চিহ্নিত ঘরগুলো আবশ্যক।</p>
      </div>

      <% if (errors && errors.length) { %>
        <div class="ja-errors" role="alert">
          <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul>
        </div>
      <% } %>

      <div class="ja-stepper">
        <div class="ja-stepper-track">
          <div class="ja-stepper-line"></div>
          <div class="ja-stepper-fill" id="jaStepperFill"></div>
          <ol class="ja-stepper-list">
            <% af.STEPS.forEach(function (s, i) { %>
              <li class="ja-stepper-item<%= i === 0 ? ' is-active' : '' %>" data-step="<%= i %>">
                <span class="ja-stepper-dot"><%= s.n %></span>
                <span class="ja-stepper-label"><%= s.label %></span>
              </li>
            <% }); %>

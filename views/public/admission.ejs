    </div>
  <% } %>

    <div class="grid g2" style="gap:1.6rem;align-items:start;margin-top:3rem">
      <div class="card">
        <h3>How admission works</h3>
        <ol style="padding-left:1.1rem;font-size:.92rem;color:var(--muted)">
          <li style="margin-bottom:.5rem">Submit this form and note your application number.</li>
          <li style="margin-bottom:.5rem">Our office calls the guardian to arrange an interview.</li>
          <li style="margin-bottom:.5rem">The applicant sits a short oral assessment.</li>
          <li>On acceptance, admission fee is paid and the seat is confirmed.</li>
        </ol>
      </div>
      <% if (feeHeads && feeHeads.length) { %>
      <div class="card">
        <h3>Fees at a glance</h3>
        <table class="data" style="font-size:.88rem">
          <thead><tr><th>Head</th><th>Type</th><th style="text-align:right">Amount</th></tr></thead>
          <tbody>
            <% feeHeads.forEach(function (f) { %>
              <tr>
                <td><%= f.name %></td>
                <td><%= f.ftype.replace('_', ' ') %></td>
                <td style="text-align:right"><%= currency %> <%= Number(f.amount).toLocaleString('en-US') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <p class="hint" style="margin-top:.7rem">Actual fees may vary by class. The office will confirm at the time of admission.</p>
      </div>
      <% } %>
    </div>

  </div>
</section>

<script>
(function () {
  var form = document.getElementById('jamiah-admission-form');
  if (!form) return;

  var BN = ['১', '২', '৩', '৪', '৫', '৬'];
  var LABELS = <%- JSON.stringify(af.STEPS.map(function (s) { return s.label; })) %>;

  var steps   = [].slice.call(form.querySelectorAll('.ja-step'));
  var dots    = [].slice.call(document.querySelectorAll('.ja-stepper-item'));
  var fill    = document.getElementById('jaStepperFill');
  var caption = document.getElementById('jaCaption');
  var count   = document.getElementById('jaCount');
  var prevBtn = document.getElementById('jaPrev');
  var nextBtn = document.getElementById('jaNext');
  var actions = document.getElementById('jaActions');
  var current = 0;

  function show(i) {
    current = Math.max(0, Math.min(steps.length - 1, i));
    steps.forEach(function (s, n) { s.classList.toggle('is-active', n === current); });
    dots.forEach(function (d, n) {
      d.classList.toggle('is-active', n === current);
      d.classList.toggle('is-done', n < current);
    });
    fill.style.width = (current / (steps.length - 1) * 100) + '%';
    caption.textContent = 'ধাপ ' + BN[current] + ' / ' + BN[steps.length - 1] + ' · ' + LABELS[current];
    count.textContent = 'ধাপ ' + BN[current] + ' / ' + BN[steps.length - 1];
    prevBtn.disabled = current === 0;
    nextBtn.hidden = current === steps.length - 1;
    actions.hidden = current !== steps.length - 1;
  }

  /* Validates only the fields on the step being left, so an applicant is
     never blocked by a field they have not reached yet. */
  function stepIsValid(i) {
    var fields = [].slice.call(steps[i].querySelectorAll('input, select, textarea'));
    var ok = true;
    var firstBad = null;
    var seenRadio = {};

    fields.forEach(function (el) {
      el.classList.remove('is-invalid');
      if (el.setCustomValidity) el.setCustomValidity('');
      if (!el.required) return;

      if (el.type === 'radio') {
        if (seenRadio[el.name]) return;
        seenRadio[el.name] = true;
        if (!form.querySelector('input[name="' + el.name + '"]:checked')) {
          ok = false;
          if (!firstBad) firstBad = el.closest('.ja-choice-grid') || el;
        }
        return;
      }

      if (!el.checkValidity()) {
        ok = false;
        el.classList.add('is-invalid');
        var jaMsg = el.validity.valueMissing
          ? el.getAttribute('data-msg')
          : (el.validity.typeMismatch || el.validity.patternMismatch)
            ? (el.getAttribute('data-msg-type') || el.getAttribute('data-msg'))
            : '';
        if (jaMsg && el.setCustomValidity) el.setCustomValidity(jaMsg);
        if (!firstBad) firstBad = el;
      }
    });

    if (!ok && firstBad) {
      firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (firstBad.focus) { try { firstBad.focus({ preventScroll: true }); } catch (e) {} }
      if (firstBad.reportValidity) { try { firstBad.reportValidity(); } catch (e) {} }
    }
    return ok;
  }

  nextBtn.addEventListener('click', function () {
    if (!stepIsValid(current)) return;
    show(current + 1);
    document.querySelector('.ja-stepper').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  prevBtn.addEventListener('click', function () {
    show(current - 1);
    document.querySelector('.ja-stepper').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* Let a visitor jump back to any step they have already completed. */
  dots.forEach(function (d, n) {
    d.style.cursor = 'pointer';
    d.addEventListener('click', function () {
      if (n < current) show(n);
      else if (n > current && stepIsValid(current)) show(current + 1);
    });
  });

  /* Clear a custom validation message as soon as the visitor edits the field. */
  document.addEventListener('input', function (e) {
    var el = e.target;
    if (el && el.setCustomValidity) { el.setCustomValidity(''); el.classList.remove('is-invalid'); }
  });

  /* "Same as present address" copies the four present-address boxes. */
  var same = document.getElementById('jaSameAddress');
  if (same) {
    var PAIRS = [
      ['ja_present_house', 'ja_permanent_village'],
      ['ja_present_moholla', 'ja_permanent_post'],
      ['ja_present_thana', 'ja_permanent_thana'],
      ['ja_present_district', 'ja_permanent_district']
    ];
    same.addEventListener('change', function () {
      if (!same.checked) return;
      PAIRS.forEach(function (p) {
        var from = document.getElementById(p[0]);
        var to = document.getElementById(p[1]);
        if (from && to) to.value = from.value;
      });
    });
  }

  form.addEventListener('submit', function (e) {
    for (var i = 0; i < steps.length; i += 1) {
      if (!stepIsValid(i)) {
        e.preventDefault();
        show(i);
        return;
      }
    }
    var btn = document.getElementById('jaSubmit');
    if (btn) { btn.disabled = true; btn.textContent = 'জমা হচ্ছে…'; }
  });

  show(0);
})();
</script>

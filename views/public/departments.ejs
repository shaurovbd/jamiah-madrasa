<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/"><%= t('crumb.home') %></a> / <%= t('nav.departments') %></div>
    <h1><%= t('nav.departments') %></h1>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="grid g2">
      <% departments.forEach(function (d, i) { %>
        <div class="card dept-card">
          <span class="num"><%= String(i + 1).padStart(2, '0') %></span>
          <h3><a href="/departments/<%= d.slug %>" style="color:inherit"><%= d.name %></a></h3>
          <p><%= d.description || '' %></p>
          <% if (d.classes && d.classes.length) { %>
            <p style="margin-top:.9rem;font-size:.85rem;color:var(--ink)">
              <strong><%= t('departments.classes_label') %>:</strong> <%= d.classes.map(function (c) { return c.name; }).join(' · ') %>
            </p>
          <% } %>
          <p style="margin-top:.5rem;font-size:.85rem"><strong><%= d.student_count %></strong> <%= t('departments.students_enrolled') %></p>
          <a class="more" href="/departments/<%= d.slug %>"><%= t('common.view_details') %> →</a>
        </div>
      <% }); %>
      <% if (!departments.length) { %><p><%= t('departments.empty') %></p><% } %>
    </div>
  </div>
</section>

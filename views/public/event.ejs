<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/"><%= t('crumb.home') %></a> / <a href="/events"><%= t('nav.events') %></a></div>
    <h1><%= ev.title %></h1>
  </div>
</div>
<section>
  <div class="wrap narrow">
    <div class="card" style="margin-bottom:1.6rem">
      <div class="grid g3" style="gap:1rem">
        <div><strong><%= t('common.date') %></strong><br><%= fmtDate(ev.event_date) %><%= ev.end_date ? ' – ' + fmtDate(ev.end_date) : '' %></div>
        <div><strong><%= t('event.location') %></strong><br><%= ev.location || t('event.campus') %></div>
        <div><strong><%= t('common.status') %></strong><br><%= new Date(ev.event_date) >= new Date(new Date().toDateString()) ? t('event.status_upcoming') : t('event.status_completed') %></div>
      </div>
    </div>
    <article class="prose">
      <% (ev.description || '').split(/\n{2,}/).forEach(function (para) { %><p><%= para %></p><% }); %>
    </article>
    <p style="margin-top:2rem"><a href="/events">← <%= t('event.back') %></a></p>
  </div>
</section>

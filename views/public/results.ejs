<div class="page-head no-print">
  <div class="wrap">
    <div class="crumb"><a href="/"><%= t('crumb.home') %></a> / <%= t('results.crumb') %></div>
    <h1><%= t('results.title') %></h1>
  </div>
</div>

<section>
  <div class="wrap narrow">
    <div class="panel no-print" style="margin-bottom:2rem">
      <p style="color:var(--muted);font-size:.93rem"><%= settings.result_notice || t('results.default_notice') %></p>
      <form method="post" action="/results">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-grid">
          <div class="field">
            <label for="exam_id"><%= t('results.examination') %> <span class="req">*</span></label>
            <select id="exam_id" name="exam_id" required>
              <option value=""><%= t('results.select_placeholder') %></option>
              <% exams.forEach(function (e) { %>
                <option value="<%= e.id %>" <%= String(form.exam_id) === String(e.id) ? 'selected' : '' %>><%= e.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="field">
            <label for="class_id"><%= t('common.class') %> <span class="req">*</span></label>
            <select id="class_id" name="class_id" required>
              <option value=""><%= t('results.select_placeholder') %></option>
              <% classes.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= String(form.class_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="field full">
            <label for="roll_no"><%= t('results.roll_number') %> <span class="req">*</span></label>
            <input id="roll_no" name="roll_no" type="text" required value="<%= form.roll_no || '' %>">
          </div>
        </div>
        <p style="margin-top:1.2rem"><button class="btn btn-green" type="submit"><%= t('results.view_result') %></button></p>
      </form>

      <% if (!exams.length) { %>
        <div class="alert alert-info" style="margin-top:1.2rem"><%= t('results.none_published') %></div>
      <% } %>
    </div>

    <% if (notFound && exams.length) { %>
      <div class="alert alert-error no-print"><%= t('results.not_found') %></div>
    <% } %>

    <% if (sheet) { %>
      <div class="result-sheet">
        <div class="result-head">
          <h2><%= site.name %></h2>
          <p style="margin:0;color:var(--muted);font-size:.9rem"><%= site.address || '' %></p>
          <p style="margin:.5rem 0 0;font-weight:600"><%= sheet.exam.name %> — <%= t('results.transcript') %></p>
        </div>

        <div class="result-meta">
          <div><b><%= t('results.student') %></b><%= sheet.student.name %></div>
          <div><b><%= t('common.roll') %></b><%= sheet.student.roll_no || '—' %></div>
          <div><b><%= t('results.admission_no') %></b><%= sheet.student.admission_no %></div>
          <div><b><%= t('common.class') %></b><%= sheet.student.class_name || '—' %><%= sheet.student.section_name ? ' (' + sheet.student.section_name + ')' : '' %></div>
          <div><b><%= t('common.department') %></b><%= sheet.student.dept_name || '—' %></div>
          <div><b><%= t('results.father_name') %></b><%= sheet.student.father_name || '—' %></div>
        </div>

        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr><th><%= t('common.subject') %></th><th style="text-align:right"><%= t('results.full_marks') %></th><th style="text-align:right"><%= t('results.obtained') %></th><th><%= t('results.grade') %></th><th><%= t('common.status') %></th></tr>
            </thead>
            <tbody>
              <% sheet.subjects.forEach(function (s) { %>
                <tr>
                  <td><%= s.subject %></td>
                  <td style="text-align:right"><%= s.full_marks %></td>
                  <td style="text-align:right"><%= s.is_absent ? t('results.absent') : (s.marks === null ? '—' : s.marks) %></td>
                  <td><%= s.grade %></td>
                  <td><%= s.is_absent ? t('results.absent') : (s.marks === null ? '—' : (s.passed ? t('results.pass') : t('results.fail'))) %></td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr style="font-weight:600;background:var(--cream)">
                <td><%= t('common.total') %></td>
                <td style="text-align:right"><%= sheet.summary.total_full %></td>
                <td style="text-align:right"><%= sheet.summary.total_obtained %></td>
                <td colspan="2"><%= sheet.summary.percent %>%</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1.4rem;align-items:center">
          <div><small style="display:block;color:var(--muted);text-transform:uppercase;font-size:.72rem;letter-spacing:.08em"><%= t('results.grade') %></small>
            <span class="grade-pill <%= sheet.summary.result === 'Failed' ? 'fail' : '' %>"><%= sheet.summary.grade %></span></div>
          <div><small style="display:block;color:var(--muted);text-transform:uppercase;font-size:.72rem;letter-spacing:.08em"><%= t('results.gpa') %></small>
            <strong style="font-size:1.1rem"><%= sheet.summary.gpa.toFixed(2) %></strong></div>
          <div><small style="display:block;color:var(--muted);text-transform:uppercase;font-size:.72rem;letter-spacing:.08em"><%= t('results.result') %></small>
            <strong style="font-size:1.1rem;color:<%= sheet.summary.result === 'Failed' ? '#b3261e' : 'var(--green-700)' %>"><%= sheet.summary.result === 'Failed' ? t('results.failed') : t('results.passed') %></strong></div>
          <div style="margin-left:auto" class="no-print">
            <button class="btn btn-outline btn-sm" onclick="window.print()"><%= t('results.print') %></button>
          </div>
        </div>

        <p style="margin-top:1.6rem;font-size:.8rem;color:var(--muted);border-top:1px dashed var(--line);padding-top:.8rem">
          <%= t('results.disclaimer') %>
        </p>
      </div>
    <% } %>
  </div>
</section>

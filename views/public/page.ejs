<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a></div>
    <h1><%= page.title %></h1>
  </div>
</div>
<section>
  <div class="wrap">
    <article class="prose">
      <% (page.body || '').split(/\n{2,}/).forEach(function (para) { %><p><%= para %></p><% }); %>
    </article>
  </div>
</section>

<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Contact</div>
    <h1>Contact Us</h1>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="grid g2" style="gap:2.5rem;align-items:start">
      <div class="panel">
        <% if (sent) { %>
          <div class="alert alert-success">Thank you. Your message has been received and the office will reply shortly.</div>
        <% } %>
        <% if (flash.error && flash.error.length) { %><div class="alert alert-error"><%= flash.error.join(' ') %></div><% } %>
        <h2 style="margin-bottom:1.1rem">Send us a message</h2>
        <form method="post" action="/contact">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-grid">
            <div class="field">
              <label for="name">Your name <span class="req">*</span></label>
              <input id="name" name="name" type="text" required value="<%= form.name || '' %>">
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" value="<%= form.phone || '' %>">
            </div>
            <div class="field full">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" value="<%= form.email || '' %>">
            </div>
            <div class="field full">
              <label for="subject">Subject</label>
              <input id="subject" name="subject" type="text" value="<%= form.subject || '' %>">
            </div>
            <div class="field full">
              <label for="message">Message <span class="req">*</span></label>
              <textarea id="message" name="message" required><%= form.message || '' %></textarea>
            </div>
          </div>
          <p style="margin-top:1.2rem"><button class="btn btn-green" type="submit">Send message</button></p>
        </form>
      </div>

      <aside>
        <div class="card" style="margin-bottom:1.2rem">
          <h3>Office</h3>
          <p style="color:var(--body)"><%= site.address || '' %></p>
          <% if (site.phone) { %><p><strong>Phone:</strong> <%= site.phone %></p><% } %>
          <% if (site.email) { %><p><strong>Email:</strong> <a href="mailto:<%= site.email %>"><%= site.email %></a></p><% } %>
        </div>
        <div class="card">
          <h3>Office hours</h3>
          <p>
            <% (settings.office_hours || 'Saturday – Thursday, 8:00 am to 4:00 pm.\nFriday closed.')
                 .split(/\r?\n/).filter(function (l) { return l.trim() !== ''; })
                 .forEach(function (line, i, all) { %><%= line %><% if (i < all.length - 1) { %><br><% } %><% }); %>
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<% if (mapUrl) { %>
<section class="alt tight">
  <div class="wrap">
    <div class="map-embed">
      <iframe src="<%= mapUrl %>" title="<%= site.name %> location"
              loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
</section>
<% } %>

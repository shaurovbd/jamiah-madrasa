<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / <a href="/departments">Departments</a> / <%= dept.name %></div>
    <h1><%= dept.name %></h1>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="prose" style="margin-bottom:2.5rem"><p><%= dept.description || '' %></p></div>

    <% if (classes.length) { %>
      <h2>Classes and Syllabus</h2>
      <div class="grid g2" style="margin-top:1.2rem">
        <% classes.forEach(function (c) { %>
          <div class="card">
            <h3><%= c.name %></h3>
            <% if (c.subjects.length) { %>
              <p style="font-size:.9rem"><%= c.subjects.map(function (s) { return s.name; }).join(' · ') %></p>
            <% } else { %>
              <p>Syllabus to be announced.</p>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (teachers.length) { %>
      <h2 style="margin-top:2.5rem">Teachers</h2>
      <div class="table-wrap" style="margin-top:1rem">
        <table class="data">
          <thead><tr><th>Name</th><th>Designation</th><th>Qualification</th></tr></thead>
          <tbody>
          <% teachers.forEach(function (t) { %>
            <tr><td><%= t.name %></td><td><%= t.designation || '' %></td><td><%= t.qualification || '' %></td></tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <p style="margin-top:2.5rem"><a class="btn btn-green" href="/admission">Apply to this department</a></p>
  </div>
</section>

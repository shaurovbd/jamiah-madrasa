<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/"><%= t('crumb.home') %></a> / <a href="/departments"><%= t('nav.departments') %></a> / <%= dept.name %></div>
    <h1><%= dept.name %></h1>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="prose" style="margin-bottom:2.5rem"><p><%= dept.description || '' %></p></div>

    <% if (classes.length) { %>
      <h2><%= t('department.classes_syllabus') %></h2>
      <div class="grid g2" style="margin-top:1.2rem">
        <% classes.forEach(function (c) { %>
          <div class="card">
            <h3><%= c.name %></h3>
            <% if (c.subjects.length) { %>
              <p style="font-size:.9rem"><%= c.subjects.map(function (s) { return s.name; }).join(' · ') %></p>
            <% } else { %>
              <p><%= t('department.syllabus_tba') %></p>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (teachers.length) { %>
      <h2 style="margin-top:2.5rem"><%= t('department.teachers') %></h2>
      <div class="table-wrap" style="margin-top:1rem">
        <table class="data">
          <thead><tr><th><%= t('common.name') %></th><th><%= t('common.designation') %></th><th><%= t('common.qualification') %></th></tr></thead>
          <tbody>
          <% teachers.forEach(function (tch) { %>
            <tr><td><%= tch.name %></td><td><%= tch.designation || '' %></td><td><%= tch.qualification || '' %></td></tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <p style="margin-top:2.5rem"><a class="btn btn-green" href="/admission"><%= t('department.apply_cta') %></a></p>
  </div>
</section>

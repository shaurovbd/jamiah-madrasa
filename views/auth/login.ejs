<div style="width:100%;max-width:410px">
  <div style="text-align:center;margin-bottom:1.6rem;color:#fff">
    <div style="width:62px;height:62px;margin:0 auto .9rem;border-radius:50%;border:2px solid #c3952f;color:#e8d59a;display:grid;place-items:center;font-family:Lora,serif;font-size:1.6rem">ج</div>
    <h1 style="color:#fff;font-size:1.45rem;margin-bottom:.2rem"><%= site.name %></h1>
    <p style="color:#a9c6ba;font-size:.9rem;margin:0">Staff &amp; Management Panel</p>
  </div>

  <div class="panel">
    <% if (flash.error && flash.error.length) { %><div class="alert alert-error"><%= flash.error.join(' ') %></div><% } %>
    <% if (flash.success && flash.success.length) { %><div class="alert alert-success"><%= flash.success.join(' ') %></div><% } %>

    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field" style="margin-bottom:1rem">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required autofocus>
      </div>
      <div class="field" style="margin-bottom:1.3rem">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-green" type="submit" style="width:100%">Sign in</button>
    </form>
  </div>

  <p style="text-align:center;margin-top:1.2rem"><a href="/" style="color:#cfe3da;font-size:.88rem">← Back to website</a></p>
</div>

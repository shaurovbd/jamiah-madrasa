<div class="card">
  <h1><%= t('portal.welcome') %></h1>
  <p class="sub"><%= t('portal.your_children', { count: children.length }) %></p>
</div>

<% children.forEach(function (c) { %>
<a class="card" href="/parent/child/<%= c.id %>" style="display:block;color:inherit">
  <div class="kid" style="margin-bottom:.9rem">
    <div class="avatar"><% if (c.photo) { %><img src="/uploads/<%= c.photo %>" alt=""><% } else { %><%= c.name.charAt(0) %><% } %></div>
    <div style="flex:1;min-width:0">
      <strong style="color:var(--ink);font-size:1.05rem"><%= c.name %></strong>
      <div class="sub"><%= c.class_name || '—' %><%= c.section_name ? ' (' + c.section_name + ')' : '' %><%= c.roll_no ? ' · ' + t('common.roll') + ' ' + c.roll_no : '' %></div>
    </div>
    <span style="font-size:1.3rem;color:var(--muted)">›</span>
  </div>
  <div class="stats">
    <div class="stat"><div class="l"><%= t('portal.att_month') %></div><div class="v"><%= c.attPct === null ? '—' : c.attPct + '%' %></div></div>
    <div class="stat <%= c.due > 0 ? 'red' : '' %>"><div class="l"><%= t('portal.fee_due') %></div><div class="v"><%= c.due > 0 ? money(c.due) : t('portal.none_due') %></div></div>
    <% if (c.hifz_para_completed > 0) { %><div class="stat"><div class="l"><%= t('portal.hifz') %></div><div class="v"><%= t('portal.paras', { n: c.hifz_para_completed }) %></div></div><% } %>
  </div>
</a>
<% }); %>

<% if (notices.length) { %>
<div class="card">
  <h2><%= t('portal.notices') %></h2>
  <% notices.forEach(function (n) { %>
    <div style="padding:.45rem 0;border-bottom:1px solid var(--line)">
      <a href="/notices/<%= n.slug %>"><%= n.title %></a>
      <div class="sub"><%= fmtDate(n.published_at || n.created_at) %></div>
    </div>
  <% }); %>
</div>
<% } %>

<div class="page-bar"><h1><%= t('admin.nav.attendance') %></h1></div>
<%- include('../../partials/tabs', { TABS: TABS, currentPath: currentPath }) %>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/attendance">
      <div class="field"><label for="class_id"><%= t('common.class') %> <span class="req">*</span></label>
        <select id="class_id" name="class_id" required>
          <option value=""><%= t('results.select_placeholder') %></option>
          <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
        </select></div>
      <div class="field"><label for="section_id"><%= t('common.section') %></label>
        <select id="section_id" name="section_id">
          <option value=""><%= t('a.att.all_sections') %></option>
          <% sections.forEach(function (s) { %><option value="<%= s.id %>" data-class="<%= s.class_id %>" <%= filters.section_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }); %>
        </select></div>
      <div class="field"><label for="shift_id"><%= t('common.shift') %></label>
        <select id="shift_id" name="shift_id">
          <option value=""><%= t('a.att.all_shifts') %></option>
          <% shifts.forEach(function (s) { %><option value="<%= s.id %>" <%= filters.shift_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }); %>
        </select></div>
      <div class="field"><label for="date"><%= t('common.date') %></label>
        <input id="date" name="date" type="date" value="<%= filters.date %>"></div>
      <button class="btn btn-primary" type="submit"><%= t('a.att.load_roster') %></button>
    </form>
  </div>
</div>

<% if (weeklyOff) { %>
  <div class="card" style="margin-bottom:1.1rem"><div class="card-body">
    <strong><%= t('a.att.weekly_off_warning', { shift: shift.name, date: fmtDate(filters.date) }) %></strong>
  </div></div>
<% } %>

<% if (filters.class_id) { %>
  <% if (students.length) { %>
    <form method="post" action="/admin/attendance">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="class_id" value="<%= filters.class_id %>">
      <input type="hidden" name="section_id" value="<%= filters.section_id || '' %>">
      <input type="hidden" name="shift_id" value="<%= filters.shift_id || '' %>">
      <input type="hidden" name="date" value="<%= filters.date %>">

      <div class="card">
        <div class="card-head">
          <h2><%= fmtDate(filters.date) %> · <%= t('a.att.n_students', { n: students.length }) %></h2>
          <span class="spacer"></span>
          <% if (shift) { %><span class="badge"><%= shift.name %> · <%= sh.window(shift) %></span><% } %>
          <% if (alreadyTaken) { %><span class="badge badge-green"><%= t('a.att.already_recorded') %></span><% } %>
          <button class="btn btn-light btn-sm" type="button" id="allPresent"><%= t('a.att.mark_all_present') %></button>
        </div>
        <div class="card-body flush">
          <div class="table-wrap">
            <table class="data">
              <thead><tr><th><%= t('common.roll') %></th><th><%= t('common.name') %></th><th style="width:330px"><%= t('common.status') %></th><th><%= t('a.remarks') %></th></tr></thead>
              <tbody>
                <% students.forEach(function (s) { %>
                  <tr>
                    <td><%= s.roll_no || '—' %></td>
                    <td><strong><%= s.name %></strong><br><small class="sub"><%= s.admission_no %></small></td>
                    <td>
                      <div class="chk-list">
                        <% ['present','absent','late','leave'].forEach(function (st) { %>
                          <label class="chk">
                            <input type="radio" name="status[id<%= s.id %>]" value="<%= st %>"
                              <%= (s.status || 'present') === st ? 'checked' : '' %>>
                            <%= label('attendance', st) %>
                          </label>
                        <% }); %>
                      </div>
                    </td>
                    <td><input type="text" name="remarks[id<%= s.id %>]" value="<%= s.remarks || '' %>" placeholder="<%= t('common.optional') %>"></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="card-body" style="border-top:1px solid var(--a-line)">
          <button class="btn btn-primary" type="submit"><%= t('a.att.save') %></button>
        </div>
      </div>
    </form>
    <script>
      document.getElementById('allPresent').addEventListener('click', function () {
        document.querySelectorAll('input[type=radio][value=present]').forEach(function (r) { r.checked = true; });
      });
    </script>
  <% } else { %>
    <div class="card"><div class="card-body empty">
      <div class="big">☗</div><p><%= t('a.att.no_students_section') %></p></div></div>
  <% } %>
<% } else { %>
  <div class="card"><div class="card-body empty">
    <div class="big">✓</div><p><%= t('a.att.choose_then_load') %></p></div></div>
<% } %>

<script>
  (function () {
    var cls = document.getElementById('class_id'), sec = document.getElementById('section_id');
    if (!cls || !sec) return;
    var all = Array.prototype.slice.call(sec.options).map(function (o) {
      return { value: o.value, text: o.text, cls: o.getAttribute('data-class'), selected: o.selected };
    });
    function filter() {
      var c = cls.value, current = sec.value;
      sec.innerHTML = '';
      all.forEach(function (o) {
        if (o.value === '' || !c || o.cls === c) {
          var opt = document.createElement('option');
          opt.value = o.value; opt.textContent = o.text; opt.setAttribute('data-class', o.cls || '');
          if (o.value === current) opt.selected = true;
          sec.appendChild(opt);
        }
      });
    }
    cls.addEventListener('change', filter);
    filter();
  })();
</script>

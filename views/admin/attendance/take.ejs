<div class="page-bar"><h1>Attendance</h1></div>
<%- include('../../partials/tabs', { TABS: TABS, currentPath: currentPath }) %>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/attendance">
      <div class="field"><label for="class_id">Class <span class="req">*</span></label>
        <select id="class_id" name="class_id" required>
          <option value="">— Select —</option>
          <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
        </select></div>
      <div class="field"><label for="section_id">Section</label>
        <select id="section_id" name="section_id">
          <option value="">All sections</option>
          <% sections.forEach(function (s) { %><option value="<%= s.id %>" data-class="<%= s.class_id %>" <%= filters.section_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }); %>
        </select></div>
      <div class="field"><label for="date">Date</label>
        <input id="date" name="date" type="date" value="<%= filters.date %>"></div>
      <button class="btn btn-primary" type="submit">Load roster</button>
    </form>
  </div>
</div>

<% if (filters.class_id) { %>
  <% if (students.length) { %>
    <form method="post" action="/admin/attendance">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="class_id" value="<%= filters.class_id %>">
      <input type="hidden" name="section_id" value="<%= filters.section_id || '' %>">
      <input type="hidden" name="date" value="<%= filters.date %>">

      <div class="card">
        <div class="card-head">
          <h2><%= h.fmtDate(filters.date) %> · <%= students.length %> students</h2>
          <span class="spacer"></span>
          <% if (alreadyTaken) { %><span class="badge badge-green">Already recorded — editing</span><% } %>
          <button class="btn btn-light btn-sm" type="button" id="allPresent">Mark all present</button>
        </div>
        <div class="card-body flush">
          <div class="table-wrap">
            <table class="data">
              <thead><tr><th>Roll</th><th>Name</th><th style="width:330px">Status</th><th>Remarks</th></tr></thead>
              <tbody>
                <% students.forEach(function (s) { %>
                  <tr>
                    <td><%= s.roll_no || '—' %></td>
                    <td><strong><%= s.name %></strong><br><small class="sub"><%= s.admission_no %></small></td>
                    <td>
                      <div class="chk-list">
                        <% ['present','absent','late','leave'].forEach(function (st) { %>
                          <label class="chk">
                            <input type="radio" name="status[id<%= s.id %>]" value="<%= st %>"
                              <%= (s.status || 'present') === st ? 'checked' : '' %>>
                            <%= st.charAt(0).toUpperCase() + st.slice(1) %>
                          </label>
                        <% }); %>
                      </div>
                    </td>
                    <td><input type="text" name="remarks[id<%= s.id %>]" value="<%= s.remarks || '' %>" placeholder="Optional"></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="card-body" style="border-top:1px solid var(--a-line)">
          <button class="btn btn-primary" type="submit">Save attendance</button>
        </div>
      </div>
    </form>
    <script>
      document.getElementById('allPresent').addEventListener('click', function () {
        document.querySelectorAll('input[type=radio][value=present]').forEach(function (r) { r.checked = true; });
      });
    </script>
  <% } else { %>
    <div class="card"><div class="card-body empty">
      <div class="big">☗</div><p>No active students in this class or section.</p></div></div>
  <% } %>
<% } else { %>
  <div class="card"><div class="card-body empty">
    <div class="big">✓</div><p>Choose a class and date, then load the roster.</p></div></div>
<% } %>

<script>
  (function () {
    var cls = document.getElementById('class_id'), sec = document.getElementById('section_id');
    if (!cls || !sec) return;
    var all = Array.prototype.slice.call(sec.options).map(function (o) {
      return { value: o.value, text: o.text, cls: o.getAttribute('data-class'), selected: o.selected };
    });
    function filter() {
      var c = cls.value, current = sec.value;
      sec.innerHTML = '';
      all.forEach(function (o) {
        if (o.value === '' || !c || o.cls === c) {
          var opt = document.createElement('option');
          opt.value = o.value; opt.textContent = o.text; opt.setAttribute('data-class', o.cls || '');
          if (o.value === current) opt.selected = true;
          sec.appendChild(opt);
        }
      });
    }
    cls.addEventListener('change', filter);
    filter();
  })();
</script>

<div class="page-bar">
  <div><h1>Students</h1><p class="sub"><%= h.num(p.total) %> <%= filters.status %> student<%= p.total === 1 ? '' : 's' %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-primary" href="/admin/students/new">+ Add student</a>
</div>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/students">
      <div class="field grow">
        <label for="q">Search</label>
        <input id="q" name="q" type="search" placeholder="Name, admission no, roll, phone" value="<%= filters.q %>">
      </div>
      <div class="field">
        <label for="department_id">Department</label>
        <select id="department_id" name="department_id">
          <option value="">All</option>
          <% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= filters.department_id === d.id ? 'selected' : '' %>><%= d.name %></option><% }); %>
        </select>
      </div>
      <div class="field">
        <label for="class_id">Class</label>
        <select id="class_id" name="class_id">
          <option value="">All</option>
          <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
        </select>
      </div>
      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <% ['active','passed','left'].forEach(function (s) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option><% }); %>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">Filter</button>
      <a class="btn btn-light" href="/admin/students">Reset</a>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body flush">
    <% if (students.length) { %>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th>Roll</th><th>Admission No</th><th>Name</th><th>Father</th><th>Class</th><th>Department</th><th>Guardian Phone</th><th>Boarder</th><th class="actions">Actions</th></tr>
          </thead>
          <tbody>
            <% students.forEach(function (s) { %>
              <tr>
                <td><%= s.roll_no || '—' %></td>
                <td><%= s.admission_no %></td>
                <td><a href="/admin/students/<%= s.id %>"><strong><%= s.name %></strong></a></td>
                <td><%= s.father_name || '—' %></td>
                <td><%= s.class_name || '—' %><%= s.section_name ? ' / ' + s.section_name : '' %></td>
                <td><%= s.dept_name || '—' %></td>
                <td><%= s.guardian_phone || '—' %></td>
                <td><% if (s.is_resident) { %><span class="badge badge-green">Hostel</span><% } else { %><span class="badge badge-grey">Day</span><% } %></td>
                <td class="actions">
                  <a class="btn btn-light btn-sm" href="/admin/students/<%= s.id %>">View</a>
                  <a class="btn btn-light btn-sm" href="/admin/students/<%= s.id %>/edit">Edit</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty"><div class="big">☗</div><p>No students match these filters.</p>
        <a class="btn btn-primary" href="/admin/students/new">Add the first student</a></div>
    <% } %>
  </div>
  <%- include('../../partials/pager', { p: p, query: query, h: h }) %>
</div>

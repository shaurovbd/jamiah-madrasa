<div class="page-bar">
  <div><h1><%= t('admin.nav.students') %></h1><p class="sub"><%= t('a.stu.count_summary', { count: h.num(p.total), status: label('status', filters.status) }) %></p></div>
  <span class="spacer"></span>
  <% if (canAccess('print') && filters.class_id) { %><a class="btn btn-light" target="_blank" href="/admin/print/id-cards?class_id=<%= filters.class_id %><%= filters.section_id ? '&section_id=' + filters.section_id : '' %>"><%= t('a.print.id_cards') %></a><% } %>
  <% if (canAccess('promotion')) { %><a class="btn btn-light" href="/admin/students/promote"><%= t('a.promo.title') %></a><% } %>
  <% if (typeof canEditStudents === 'undefined' || canEditStudents) { %><a class="btn btn-light" href="/admin/students/import"><%= t('a.imp.title') %></a><a class="btn btn-primary" href="/admin/students/new"><%= t('a.stu.add') %></a><% } %>
</div>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/students">
      <div class="field grow">
        <label for="q"><%= t('common.search') %></label>
        <input id="q" name="q" type="search" placeholder="<%= t('a.stu.search_ph') %>" value="<%= filters.q %>">
      </div>
      <div class="field">
        <label for="department_id"><%= t('common.department') %></label>
        <select id="department_id" name="department_id">
          <option value=""><%= t('common.all') %></option>
          <% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= filters.department_id === d.id ? 'selected' : '' %>><%= d.name %></option><% }); %>
        </select>
      </div>
      <div class="field">
        <label for="class_id"><%= t('common.class') %></label>
        <select id="class_id" name="class_id">
          <option value=""><%= t('common.all') %></option>
          <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
        </select>
      </div>
      <div class="field">
        <label for="status"><%= t('common.status') %></label>
        <select id="status" name="status">
          <% ['active','passed','left'].forEach(function (s) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= label('status', s) %></option><% }); %>
        </select>
      </div>
      <button class="btn btn-primary" type="submit"><%= t('common.filter') %></button>
      <a class="btn btn-light" href="/admin/students"><%= t('common.reset') %></a>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body flush">
    <% if (students.length) { %>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th><%= t('common.roll') %></th><th><%= t('results.admission_no') %></th><th><%= t('common.name') %></th><th><%= t('a.father') %></th><th><%= t('common.class') %></th><th><%= t('common.department') %></th><th><%= t('a.guardian_phone') %></th><th><%= t('a.stu.boarder') %></th><th class="actions"><%= t('common.actions') %></th></tr>
          </thead>
          <tbody>
            <% students.forEach(function (s) { %>
              <tr>
                <td><%= s.roll_no || '—' %></td>
                <td><%= s.admission_no %></td>
                <td><a href="/admin/students/<%= s.id %>"><strong><%= s.name %></strong></a></td>
                <td><%= s.father_name || '—' %></td>
                <td><%= s.class_name || '—' %><%= s.section_name ? ' / ' + s.section_name : '' %></td>
                <td><%= s.dept_name || '—' %></td>
                <td><%= s.guardian_phone || '—' %></td>
                <td><% if (s.is_resident) { %><span class="badge badge-green"><%= t('admin.nav.hostel') %></span><% } else { %><span class="badge badge-grey"><%= t('a.day') %></span><% } %></td>
                <td class="actions">
                  <a class="btn btn-light btn-sm" href="/admin/students/<%= s.id %>"><%= t('common.view') %></a>
                  <a class="btn btn-light btn-sm" href="/admin/students/<%= s.id %>/edit"><%= t('common.edit') %></a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty"><div class="big">☗</div><p><%= t('a.stu.none_match') %></p>
        <a class="btn btn-primary" href="/admin/students/new"><%= t('a.stu.add_first') %></a></div>
    <% } %>
  </div>
  <%- include('../../partials/pager', { p: p, query: query, h: h }) %>
</div>

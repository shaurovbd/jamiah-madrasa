<div class="page-bar">
  <div><h1><%= student.name %></h1><p class="sub"><%= student.admission_no %> · <%= student.class_name || 'No class' %><%= student.section_name ? ' / ' + student.section_name : '' %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/students"><%= t('a.stu.back_all') %></a>
  <a class="btn btn-primary" href="/admin/students/<%= student.id %>/edit"><%= t('common.edit') %></a>
</div>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <div class="profile-head">
      <% if (student.photo) { %>
        <img class="photo-lg" src="/uploads/<%= student.photo %>" alt="<%= student.name %>">
      <% } else { %>
        <div class="photo-ph"><%= student.name.charAt(0).toUpperCase() %></div>
      <% } %>
      <div style="flex:1;min-width:240px">
        <h2 style="margin-bottom:.2rem"><%= student.name %></h2>
        <p class="sub" style="margin-bottom:.6rem">
          <%= student.dept_name || '—' %> ·
          <span class="badge badge-<%= student.status === 'active' ? 'green' : 'grey' %>"><%= label('status', student.status) %></span>
          <% if (student.is_resident) { %> <span class="badge badge-blue"><%= t('a.stu.boarder') %></span><% } %>
        </p>
        <dl class="kv">
          <dt><%= t('results.roll_number') %></dt><dd><%= student.roll_no || '—' %></dd>
          <dt><%= t('a.father_name') %></dt><dd><%= student.father_name || '—' %></dd>
          <dt><%= t('a.guardian_phone') %></dt><dd><%= student.guardian_phone || '—' %></dd>
          <dt><%= t('a.dob') %></dt><dd><%= student.dob ? fmtDate(student.dob) : '—' %></dd>
          <dt><%= t('a.adm.admitted') %></dt><dd><%= student.admission_date ? fmtDate(student.admission_date) : '—' %></dd>
          <dt><%= t('common.address') %></dt><dd><%= student.address || '—' %></dd>
        </dl>
      </div>
      <div style="min-width:190px">
        <div class="stat-card <%= dues > 0 ? 'red' : '' %>" style="margin-bottom:.7rem">
          <div class="label"><%= t('a.stu.outstanding_dues') %></div>
          <div class="value" style="font-size:1.25rem"><%= money(dues) %></div>
        </div>
        <% if (student.hifz_para_completed > 0) { %>
          <div class="stat-card gold">
            <div class="label"><%= t('a.hifz.completed') %></div>
            <div class="value" style="font-size:1.25rem"><%= student.hifz_para_completed %> <%= t('a.hifz.of_30') %></div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="grid g4" style="margin-bottom:1.1rem">
  <div class="stat-card"><div class="label"><%= t('a.hifz.days_recorded') %></div><div class="value"><%= h.num(att.total || 0) %></div></div>
  <div class="stat-card"><div class="label"><%= t('a.att.present') %></div><div class="value"><%= h.num(att.present || 0) %></div>
    <div class="foot"><%= att.total ? Math.round((Number(att.present||0) / Number(att.total)) * 100) : 0 %><%= t('a.stu.attendance_pct') %></div></div>
  <div class="stat-card red"><div class="label"><%= t('results.absent') %></div><div class="value"><%= h.num(att.absent || 0) %></div></div>
  <div class="stat-card gold"><div class="label"><%= t('a.att.on_leave') %></div><div class="value"><%= h.num(att.onleave || 0) %></div></div>
</div>

<div class="grid g2" style="align-items:start">
  <div class="card">
    <div class="card-head"><h2><%= t('a.exam.exam_results') %></h2></div>
    <div class="card-body flush">
      <% if (results.length) { %>
        <div class="table-wrap">
          <table class="data compact">
            <thead><tr><th><%= t('a.exam.exam') %></th><th class="num"><%= t('a.exam.marks') %></th><th class="num">%</th><th><%= t('results.grade') %></th><th><%= t('results.result') %></th><th class="actions"></th></tr></thead>
            <tbody>
              <% results.forEach(function (r) { %>
                <tr>
                  <td><%= r.exam.name %></td>
                  <td class="num"><%= r.summary.total_obtained %>/<%= r.summary.total_full %></td>
                  <td class="num"><%= r.summary.percent %></td>
                  <td><%= r.summary.grade %></td>
                  <td><span class="badge badge-<%= r.summary.result === 'Passed' ? 'green' : 'red' %>"><%= r.summary.result %></span></td>
                  <td class="actions"><a class="btn btn-light btn-sm" href="/admin/exams/<%= r.exam.id %>/marksheet/<%= student.id %>"><%= t('a.marksheet') %></a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %><div class="empty"><%= t('a.exam.no_marks_yet') %></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('admin.nav.fees') %></h2><span class="spacer"></span>
      <a class="btn btn-light btn-sm" href="/admin/fees?q=<%= encodeURIComponent(student.admission_no) %>"><%= t('common.all') %></a></div>
    <div class="card-body flush">
      <% if (invoices.length) { %>
        <div class="table-wrap">
          <table class="data compact">
            <thead><tr><th><%= t('routine.period') %></th><th class="num"><%= t('a.fee.billed') %></th><th class="num"><%= t('a.paid') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
            <tbody>
              <% invoices.forEach(function (i) { %>
                <tr>
                  <td><%= fmtPeriod(i.period) %></td>
                  <td class="num"><%= money(Number(i.total_amount) - Number(i.discount)) %></td>
                  <td class="num"><%= money(i.paid_amount) %></td>
                  <td><span class="badge badge-<%= i.status === 'paid' ? 'green' : (i.status === 'partial' ? 'amber' : 'red') %>"><%= label('status', i.status) %></span></td>
                  <td class="actions"><a class="btn btn-light btn-sm" href="/admin/fees/invoice/<%= i.id %>"><%= t('common.open') %></a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %><div class="empty"><%= t('a.stu.no_invoices') %></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('a.hifz.recent_entries') %></h2><span class="spacer"></span>
      <a class="btn btn-light btn-sm" href="/admin/hifz/student/<%= student.id %>"><%= t('a.hifz.full_record') %></a></div>
    <div class="card-body flush">
      <% if (hifz.length) { %>
        <div class="table-wrap">
          <table class="data compact">
            <thead><tr><th><%= t('common.date') %></th><th><%= t('a.hifz.sabak') %></th><th><%= t('a.hifz.sabqi') %></th><th><%= t('a.hifz.manzil') %></th><th><%= t('a.hifz.rating') %></th></tr></thead>
            <tbody>
              <% hifz.forEach(function (x) { %>
                <tr>
                  <td><%= fmtDate(x.pdate) %></td>
                  <td><%= x.sabak_surah || '—' %> <%= x.sabak_from ? x.sabak_from + '–' + (x.sabak_to || '') : '' %></td>
                  <td><%= x.sabqi_para || '—' %></td>
                  <td><%= x.manzil_para || '—' %></td>
                  <td><span class="badge badge-<%= x.rating === 'excellent' ? 'green' : (x.rating === 'weak' ? 'red' : 'grey') %>"><%= label('rating', x.rating) %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %><div class="empty"><%= t('a.hifz.none_recorded') %></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('a.stu.hostel_library') %></h2></div>
    <div class="card-body">
      <h3 style="font-size:.9rem"><%= t('admin.nav.hostel') %></h3>
      <% if (hostel) { %>
        <p><%- t('a.hostel.allocated_line', { room: t('a.room') + ' <strong>' + h.esc(hostel.room_no) + '</strong>' + (hostel.block ? ' · ' + h.esc(hostel.block) : ''), date: h.esc(fmtDate(hostel.allocated_on)) }) %></p>
      <% } else { %><p class="sub"><%= t('a.hostel.not_allocated') %></p><% } %>

      <h3 style="font-size:.9rem;margin-top:1.2rem"><%= t('a.lib.books_on_loan') %></h3>
      <% if (issues.length) { %>
        <table class="data compact">
          <thead><tr><th><%= t('common.title') %></th><th><%= t('a.due') %></th><th><%= t('common.status') %></th></tr></thead>
          <tbody>
            <% issues.forEach(function (b) { %>
              <tr><td><%= b.title %></td><td><%= fmtDate(b.due_date) %></td>
                <td><span class="badge badge-<%= b.status === 'returned' ? 'green' : 'amber' %>"><%= label('status', b.status) %></span></td></tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %><p class="sub"><%= t('a.lib.no_activity') %></p><% } %>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.1rem;border-color:#edc2bd">
  <div class="card-body" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
    <div><strong style="color:#8c2016"><%= t('a.stu.delete_this') %></strong>
      <p class="sub" style="margin:0"><%= t('a.stu.delete_hint') %></p></div>
    <span class="spacer"></span>
    <form method="post" action="/admin/students/<%= student.id %>" data-confirm="Delete <%= student.name %> and every linked record? This cannot be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="DELETE">
      <button class="btn btn-danger" type="submit"><%= t('a.stu.delete_button') %></button>
    </form>
  </div>
</div>

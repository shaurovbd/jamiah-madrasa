<style>
  .cards{display:grid;grid-template-columns:repeat(2,85.6mm);grid-auto-rows:54mm;gap:4mm 6mm;justify-content:center;padding:10mm 0}
  .idc{position:relative;width:85.6mm;height:54mm;border-radius:3.2mm;overflow:hidden;background:#fff;border:.3mm solid var(--line);display:grid;grid-template-rows:12.5mm 1fr 6mm;font-size:2.55mm;break-inside:avoid}
  .idc-head{background:linear-gradient(120deg,var(--accent),color-mix(in oklab,var(--accent) 70%,#000));color:#fff;display:flex;align-items:center;gap:2mm;padding:0 3mm}
  .idc-mark{flex:0 0 8mm;height:8mm;border-radius:50%;border:.5mm solid var(--accent2);display:grid;place-items:center;font:700 3.6mm "Lora",serif;color:var(--accent2)}
  .idc-org{line-height:1.15;min-width:0}
  .idc-org b{display:block;font-size:3mm;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .idc-org span{font-size:2.1mm;opacity:.85;letter-spacing:.06em;text-transform:uppercase}
  .idc-body{display:grid;grid-template-columns:19mm 1fr 15mm;gap:2.4mm;padding:2.4mm 3mm 1mm;align-items:start}
  .idc-photo{width:19mm;height:23mm;border-radius:1.6mm;object-fit:cover;background:#eef2f0;border:.3mm solid var(--line);display:grid;place-items:center;color:#9aa6a0;font-size:7mm}
  .idc-name{font-weight:700;font-size:3.2mm;line-height:1.2;margin-bottom:1.2mm;color:var(--ink)}
  .idc-row{display:flex;gap:1.2mm;line-height:1.45}
  .idc-row i{font-style:normal;color:var(--muted);min-width:11mm}
  .idc-row b{font-weight:600}
  .idc-qr{width:15mm;height:15mm;margin-top:1mm}
  .idc-chip{display:inline-block;margin-top:1.2mm;background:color-mix(in oklab,var(--accent) 12%,#fff);color:var(--accent);border-radius:1mm;padding:.3mm 1.4mm;font-weight:700;font-size:2.2mm}
  .idc-foot{background:color-mix(in oklab,var(--accent) 8%,#fff);border-top:.3mm solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 3mm;font-size:2.05mm;color:var(--muted)}
  .idc-foot b{color:var(--accent2)}
</style>

<% if (!students.length) { %>
  <div class="empty-note"><%= t('a.print.no_students') %></div>
<% } %>
<%
  var perPage = 10;
  for (var p = 0; p < students.length; p += perPage) {
%>
<div class="sheet"><div class="cards">
  <% students.slice(p, p + perPage).forEach(function (s) { %>
  <div class="idc">
    <div class="idc-head">
      <div class="idc-mark">ج</div>
      <div class="idc-org"><b><%= org.name %></b><span><%= t('a.print.student_id_card') %></span></div>
    </div>
    <div class="idc-body">
      <% if (s.photo) { %><img class="idc-photo" src="/uploads/<%= s.photo %>" alt=""><% } else { %><div class="idc-photo">☺</div><% } %>
      <div>
        <div class="idc-name"><%= s.name %></div>
        <div class="idc-row"><i><%= t('a.print.id') %></i><b><%= s.admission_no %></b></div>
        <div class="idc-row"><i><%= t('common.class') %></i><b><%= s.class_name || '—' %><%= s.section_name ? ' (' + s.section_name + ')' : '' %></b></div>
        <div class="idc-row"><i><%= t('common.roll') %></i><b><%= s.roll_no || '—' %></b></div>
        <% if (s.blood_group) { %><div class="idc-row"><i><%= t('a.print.blood') %></i><b><%= s.blood_group %></b></div><% } %>
        <div class="idc-row"><i><%= t('a.print.guardian') %></i><b><%= s.guardian_phone || '—' %></b></div>
      </div>
      <div><img class="idc-qr" src="<%= s.qr %>" alt=""><% if (s.year_name) { %><div class="idc-chip"><%= s.year_name %></div><% } %></div>
    </div>
    <div class="idc-foot"><span><%= org.address %></span><b><%= org.phone %></b></div>
  </div>
  <% }); %>
</div></div>
<% } %>

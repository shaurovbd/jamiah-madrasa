<div class="page-bar"><div><h1><%= t('admin.nav.gallery') %></h1><p class="sub"><%= t('a.web.gallery_sub') %></p></div></div>

<div class="grid" style="grid-template-columns:1fr 330px;align-items:start;gap:1.1rem">
  <div class="card">
    <div class="card-head"><h2><%= images.length %> <%= t('a.web.image_lower') %><%= images.length === 1 ? '' : 's' %></h2></div>
    <div class="card-body">
      <% if (images.length) { %>
        <div class="grid g4">
          <% images.forEach(function (img) { %>
            <div style="border:1px solid var(--a-line);border-radius:8px;overflow:hidden;background:#fff">
              <img src="/uploads/<%= img.image %>" alt="<%= img.title || '' %>" style="width:100%;height:130px;object-fit:cover">
              <div style="padding:.5rem .6rem">
                <div style="font-size:.82rem;color:var(--a-ink);font-weight:600"><%= img.title || '—' %></div>
                <div class="sub" style="font-size:.76rem"><%= img.album %></div>
                <form method="post" action="/admin/gallery/<%= img.id %>" style="margin-top:.4rem" data-confirm="<%= t('a.web.confirm_image') %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE">
                  <button class="btn btn-danger btn-sm" type="submit"><%= t('common.delete') %></button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %><div class="empty"><div class="big">▣</div><p><%= t('a.web.no_photos') %></p></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('a.web.upload_images') %></h2></div>
    <div class="card-body">
      <form method="post" action="/admin/gallery" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field" style="margin-bottom:.7rem"><label for="album"><%= t('a.web.album') %></label>
          <input id="album" name="album" type="text" placeholder="<%= t('event.campus') %>" value="Campus"></div>
        <div class="field" style="margin-bottom:.7rem"><label for="title"><%= t('a.web.caption_all') %></label>
          <input id="title" name="title" type="text"></div>
        <div class="field" style="margin-bottom:.9rem"><label for="images"><%= t('a.web.images') %> <span class="req">*</span></label>
          <input id="images" name="images" type="file" accept="image/*" multiple required>
          <span class="hint"><%= t('a.web.upload_hint') %></span></div>
        <button class="btn btn-primary" type="submit" style="width:100%"><%= t('a.web.upload') %></button>
      </form>
    </div>
  </div>
</div>

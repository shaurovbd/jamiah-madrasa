<div class="page-bar">
  <div><h1><%= t('home.stat_staff') %></h1><p class="sub"><%= t('a.staff.count_summary', { count: h.num(p.total), status: label('status', filters.status), amount: money(payroll) }) %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-primary" href="/admin/staff/new"><%= t('a.staff.add') %></a>
</div>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/staff">
      <div class="field grow"><label for="q"><%= t('common.search') %></label>
        <input id="q" name="q" type="search" placeholder="<%= t('a.staff.search_ph') %>" value="<%= filters.q %>"></div>
      <div class="field"><label for="department_id"><%= t('common.department') %></label>
        <select id="department_id" name="department_id"><option value=""><%= t('common.all') %></option>
          <% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= filters.department_id === d.id ? 'selected' : '' %>><%= d.name %></option><% }); %>
        </select></div>
      <div class="field"><label for="status"><%= t('common.status') %></label>
        <select id="status" name="status">
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= t('common.active') %></option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>><%= t('common.inactive') %></option>
        </select></div>
      <button class="btn btn-primary" type="submit"><%= t('common.filter') %></button>
      <a class="btn btn-light" href="/admin/staff"><%= t('common.reset') %></a>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body flush">
    <% if (staff.length) { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th><%= t('a.staff.no') %></th><th><%= t('common.name') %></th><th><%= t('common.designation') %></th><th><%= t('common.department') %></th><th><%= t('common.phone') %></th><th><%= t('a.joined') %></th><th class="num"><%= t('a.staff.salary') %></th><th class="actions"></th></tr></thead>
        <tbody>
          <% staff.forEach(function (s) { %>
            <tr>
              <td><%= s.staff_no %></td>
              <td><a href="/admin/staff/<%= s.id %>"><strong><%= s.name %></strong></a></td>
              <td><%= s.designation || '—' %></td>
              <td><%= s.dept_name || '—' %></td>
              <td><%= s.phone || '—' %></td>
              <td><%= s.join_date ? fmtDate(s.join_date) : '—' %></td>
              <td class="num"><%= money(s.salary) %></td>
              <td class="actions">
                <a class="btn btn-light btn-sm" href="/admin/staff/<%= s.id %>"><%= t('common.view') %></a>
                <a class="btn btn-light btn-sm" href="/admin/staff/<%= s.id %>/edit"><%= t('common.edit') %></a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <div class="empty"><div class="big">☖</div><p><%= t('a.staff.none_match') %></p>
        <a class="btn btn-primary" href="/admin/staff/new"><%= t('a.staff.add_member') %></a></div>
    <% } %>
  </div>
  <%- include('../../partials/pager', { p: p, query: query, h: h }) %>
</div>

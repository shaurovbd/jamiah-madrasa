<div class="page-bar">
  <div><h1><%= member.name %></h1><p class="sub"><%= member.staff_no %> · <%= member.designation || 'Staff' %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/staff"><%= t('a.staff.back_all') %></a>
  <a class="btn btn-primary" href="/admin/staff/<%= member.id %>/edit"><%= t('common.edit') %></a>
</div>

<div class="grid g2" style="align-items:start">
  <div class="card">
    <div class="card-body">
      <div class="profile-head" style="margin-bottom:1.2rem">
        <% if (member.photo) { %><img class="photo-lg" src="/uploads/<%= member.photo %>" alt="<%= member.name %>">
        <% } else { %><div class="photo-ph"><%= member.name.charAt(0).toUpperCase() %></div><% } %>
        <div>
          <h2 style="margin-bottom:.2rem"><%= member.name %></h2>
          <p class="sub"><%= member.designation || '—' %> · <span class="badge badge-<%= member.status === 'active' ? 'green' : 'grey' %>"><%= label('status', member.status) %></span></p>
        </div>
      </div>
      <dl class="kv">
        <dt><%= t('common.department') %></dt><dd><%= member.dept_name || '—' %></dd>
        <dt><%= t('common.shift') %></dt><dd><%= member.shift_name || '—' %></dd>
        <dt><%= t('common.qualification') %></dt><dd><%= member.qualification || '—' %></dd>
        <dt><%= t('common.phone') %></dt><dd><%= member.phone || '—' %></dd>
        <dt><%= t('common.email') %></dt><dd><%= member.email || '—' %></dd>
        <dt><%= t('common.address') %></dt><dd><%= member.address || '—' %></dd>
        <dt><%= t('a.joined') %></dt><dd><%= member.join_date ? fmtDate(member.join_date) : '—' %></dd>
        <dt><%= t('a.staff.salary_monthly') %></dt><dd><%= money(member.salary) %></dd>
        <dt><%= t('a.staff.panel_account') %></dt><dd><%= member.username ? member.username + ' (' + member.role + ')' : 'No login' %></dd>
      </dl>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('a.staff.teaching') %></h2></div>
    <div class="card-body">
      <h3 style="font-size:.9rem"><%= t('a.staff.class_teacher_of') %></h3>
      <% if (sections.length) { %>
        <p><%= sections.map(function (s) { return (s.class_name || '') + ' / ' + s.name; }).join(', ') %></p>
      <% } else { %><p class="sub"><%= t('a.staff.not_class_teacher') %></p><% } %>

      <h3 style="font-size:.9rem;margin-top:1.2rem"><%= t('a.staff.subjects_taught') %></h3>
      <% if (subjects.length) { %>
        <table class="data compact">
          <thead><tr><th><%= t('common.subject') %></th><th><%= t('common.class') %></th></tr></thead>
          <tbody>
            <% subjects.forEach(function (s) { %><tr><td><%= s.name %></td><td><%= s.class_name || '—' %></td></tr><% }); %>
          </tbody>
        </table>
      <% } else { %><p class="sub"><%= t('a.staff.no_subjects') %></p><% } %>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.1rem;border-color:#edc2bd">
  <div class="card-body" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
    <div><strong style="color:#8c2016"><%= t('a.staff.remove_member') %></strong>
      <p class="sub" style="margin:0"><%= t('a.staff.remove_hint') %></p></div>
    <span class="spacer"></span>
    <form method="post" action="/admin/staff/<%= member.id %>" data-confirm="Remove <%= member.name %> from the staff list?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE">
      <button class="btn btn-danger" type="submit"><%= t('common.remove') %></button>
    </form>
  </div>
</div>

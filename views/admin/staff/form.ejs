<div class="page-bar">
  <div><h1><%= isNew ? 'Add staff member' : 'Edit staff member' %></h1></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="<%= isNew ? '/admin/staff' : '/admin/staff/' + member.id %>"><%= t('common.cancel') %></a>
</div>

<form method="post" action="<%= isNew ? '/admin/staff' : '/admin/staff/' + member.id %>" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (!isNew) { %><input type="hidden" name="_method" value="PUT"><% } %>
  <div class="card">
    <div class="card-body">
      <div class="form-grid">
        <div class="field"><label for="staff_no"><%= t('a.staff.number') %> <span class="req">*</span></label>
          <input id="staff_no" name="staff_no" type="text" required value="<%= member.staff_no || '' %>"></div>
        <div class="field full" style="grid-column:span 2"><label for="name"><%= t('a.full_name') %> <span class="req">*</span></label>
          <input id="name" name="name" type="text" required value="<%= member.name || '' %>"></div>
        <div class="field"><label for="designation"><%= t('common.designation') %></label>
          <input id="designation" name="designation" type="text" placeholder="<%= t('a.staff.hifz_teacher') %>" value="<%= member.designation || '' %>"></div>
        <div class="field"><label for="department_id"><%= t('common.department') %></label>
          <select id="department_id" name="department_id"><option value=""><%= t('common.opt_none') %></option>
            <% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= member.department_id === d.id ? 'selected' : '' %>><%= d.name %></option><% }); %>
          </select></div>
        <div class="field"><label for="shift_id"><%= t('common.shift') %></label>
          <select id="shift_id" name="shift_id"><option value=""><%= t('common.opt_none') %></option>
            <% shifts.forEach(function (s) { %><option value="<%= s.id %>" <%= member.shift_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }); %>
          </select>
          <span class="hint"><%= t('a.staff.shift_hint') %></span></div>
        <div class="field"><label for="qualification"><%= t('common.qualification') %></label>
          <input id="qualification" name="qualification" type="text" value="<%= member.qualification || '' %>"></div>
        <div class="field"><label for="phone"><%= t('common.phone') %></label>
          <input id="phone" name="phone" type="tel" value="<%= member.phone || '' %>"></div>
        <div class="field"><label for="email"><%= t('common.email') %></label>
          <input id="email" name="email" type="email" value="<%= member.email || '' %>"></div>
        <div class="field"><label for="join_date"><%= t('a.staff.joining_date') %></label>
          <input id="join_date" name="join_date" type="date" value="<%= h.inputDate(member.join_date) %>"></div>
        <div class="field full" style="grid-column:span 2"><label for="address"><%= t('common.address') %></label>
          <input id="address" name="address" type="text" value="<%= member.address || '' %>"></div>
        <div class="field"><label for="salary"><%= t('a.staff.salary_monthly') %></label>
          <input id="salary" name="salary" type="number" step="0.01" value="<%= member.salary || 0 %>"></div>
        <div class="field"><label for="status"><%= t('common.status') %></label>
          <select id="status" name="status">
            <option value="active" <%= member.status === 'inactive' ? '' : 'selected' %>><%= t('common.active') %></option>
            <option value="inactive" <%= member.status === 'inactive' ? 'selected' : '' %>><%= t('common.inactive') %></option>
          </select></div>
        <div class="field"><label for="photo"><%= t('a.photograph') %></label>
          <input id="photo" name="photo" type="file" accept="image/*"></div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit"><%= isNew ? 'Add staff member' : 'Save changes' %></button>
        <a class="btn btn-light" href="<%= isNew ? '/admin/staff' : '/admin/staff/' + member.id %>"><%= t('common.cancel') %></a>
      </div>
    </div>
  </div>
</form>

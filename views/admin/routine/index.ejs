<div class="page-bar"><h1><%= t('admin.nav.routine') %></h1></div>
<%- include('../../partials/tabs', { TABS: TABS, currentPath: currentPath }) %>

<style>
  .rt-table { width:100%; border-collapse:collapse; font-size:.86rem }
  .rt-table th, .rt-table td { border:1px solid #dfe3e6; padding:.4rem; vertical-align:top }
  .rt-table thead th { background:#f4f6f7; text-align:center; white-space:nowrap }
  .rt-period { width:120px; white-space:nowrap; background:#fafbfc }
  .rt-period small { display:block; color:#6b7280; font-weight:400 }
  .rt-break td { background:#fbf7ec; text-align:center; color:#8a6d3b; font-weight:600 }
  .rt-cell select, .rt-cell input { width:100%; margin-bottom:.25rem; font-size:.82rem; padding:.25rem }
  .rt-cell input { margin-bottom:0 }
  .rt-scroll { overflow-x:auto }
  .rt-clash { margin:0 0 1rem; }
  .rt-clash ul { margin:.4rem 0 0 1.1rem }
  @media print {
    .page-bar, .tabs, .card-head, form.rt-pick, .rt-actions, .sidebar, .topbar { display:none !important }
    .rt-cell select, .rt-cell input { border:none; background:none }
  }
</style>

<div class="card">
  <div class="card-head"><h2><%= t('a.rt.choose_class') %></h2></div>
  <div class="card-body">
    <form method="get" action="/admin/routine/classes" class="rt-pick grid"
          style="grid-template-columns:repeat(3,1fr) auto;gap:.8rem;align-items:end">
      <div class="field">
        <label for="class_id"><%= t('common.class') %> <span class="req">*</span></label>
        <select id="class_id" name="class_id" required>
          <option value=""><%= t('results.select_placeholder') %></option>
          <% classes.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= classId === c.id ? 'selected' : '' %>><%= c.dept_name ? c.dept_name + ' · ' : '' %><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="field">
        <label for="section_id"><%= t('common.section') %></label>
        <select id="section_id" name="section_id">
          <option value=""><%= t('a.rt.whole_class') %></option>
          <% sections.forEach(function (s) { %>
            <option value="<%= s.id %>" <%= sectionId === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="field">
        <label for="year_id"><%= t('a.academic_year') %></label>
        <select id="year_id" name="year_id">
          <option value=""><%= t('a.rt.not_recorded') %></option>
          <% years.forEach(function (y) { %>
            <option value="<%= y.id %>" <%= yearId === y.id ? 'selected' : '' %>><%= y.name %><%= y.is_current ? ' (current)' : '' %></option>
          <% }); %>
        </select>
      </div>
      <div class="field"><button class="btn btn-primary" type="submit"><%= t('a.rt.show_routine') %></button></div>
    </form>
  </div>
</div>

<% if (clashes.length) { %>
  <div class="alert alert-error rt-clash">
    <strong><%= t('a.rt.clash_heading') %></strong>
    <%= t('a.rt.nothing_saved') %>
    <ul>
      <% clashes.forEach(function (c) { %>
        <li><%= t('a.rt.clash_line', { teacher: c.teacher, day: c.day, period: c.period, cls: c.where }) %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<% if (!classId) { %>
  <div class="card"><div class="card-body">
    <div class="empty"><%= t('a.rt.pick_class') %></div>
  </div></div>
<% } else if (!periods.length) { %>
  <div class="card"><div class="card-body">
    <div class="empty">
      <%= t('a.rt.no_periods_prefix') %>
      <a href="/admin/routine/periods"><%= t('a.rt.periods_times') %></a> <%= t('a.tab_period') %>
    </div>
  </div></div>
<% } else { %>
  <form method="post" action="/admin/routine/classes">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="class_id" value="<%= classId %>">
    <input type="hidden" name="section_id" value="<%= sectionId || '' %>">
    <input type="hidden" name="year_id" value="<%= yearId || '' %>">

    <div class="card">
      <div class="card-head"><h2><%= t('a.rt.weekly_routine') %></h2></div>
      <div class="card-body flush">
        <% if (!subjects.length) { %>
          <div class="empty" style="padding:.8rem">
            <%= t('a.rt.no_subjects_prefix') %>
            <a href="/admin/academics/subjects"><%= t('admin.nav.academics') %></a> <%= t('a.rt.no_subjects_suffix') %>
          </div>
        <% } %>
        <div class="rt-scroll">
          <table class="rt-table">
            <thead>
              <tr>
                <th class="rt-period"><%= t('routine.period') %></th>
                <% DAYS.forEach(function (d) { %><th><%= d.bn %><br><small><%= d.en %></small></th><% }); %>
              </tr>
            </thead>
            <tbody>
              <% periods.forEach(function (p) { %>
                <% if (p.is_break) { %>
                  <tr class="rt-break">
                    <td class="rt-period"><strong><%= p.name %></strong><small><%= hhmm(p.start_time) %>–<%= hhmm(p.end_time) %></small></td>
                    <td colspan="<%= DAYS.length %>"><%= p.name %> · <%= hhmm(p.start_time) %>–<%= hhmm(p.end_time) %></td>
                  </tr>
                <% } else { %>
                  <tr>
                    <td class="rt-period"><strong><%= p.name %></strong><small><%= hhmm(p.start_time) %>–<%= hhmm(p.end_time) %></small></td>
                    <% DAYS.forEach(function (d) { %>
                      <% var key = d.n + '_' + p.id; var cell = grid[key] || {}; %>
                      <td class="rt-cell">
                        <select name="s_<%= key %>" aria-label="<%= t('common.subject') %>">
                          <option value=""><%= t('a.rt.opt_subject') %></option>
                          <% subjects.forEach(function (s) { %>
                            <option value="<%= s.id %>" <%= Number(cell.subject_id) === s.id ? 'selected' : '' %>><%= s.name %></option>
                          <% }); %>
                        </select>
                        <select name="t_<%= key %>" aria-label="<%= t('role.teacher') %>">
                          <option value=""><%= t('a.rt.opt_teacher') %></option>
                          <% teachers.forEach(function (tch) { %>
                            <option value="<%= tch.id %>" <%= Number(cell.teacher_id) === tch.id ? 'selected' : '' %>><%= tch.name %></option>
                          <% }); %>
                        </select>
                        <input type="text" name="r_<%= key %>" value="<%= cell.room || '' %>" placeholder="<%= t('a.room') %>" aria-label="<%= t('a.room') %>">
                      </td>
                    <% }); %>
                  </tr>
                <% } %>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="rt-actions" style="display:flex;gap:.6rem;margin-top:1rem">
      <button class="btn btn-primary" type="submit"><%= t('a.rt.save_routine') %></button>
      <button class="btn btn-light" type="button" onclick="window.print()"><%= t('common.print') %></button>
    </div>
  </form>
<% } %>

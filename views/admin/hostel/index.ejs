<div class="page-bar">
  <div><h1>Hostel</h1><p class="sub">Rooms, capacity and current allocations</p></div>
</div>

<div class="grid g4" style="margin-bottom:1.1rem">
  <div class="stat-card"><div class="label">Total capacity</div><div class="value"><%= h.num(stats.capacity) %></div></div>
  <div class="stat-card blue"><div class="label">Occupied</div><div class="value"><%= h.num(stats.occupied) %></div></div>
  <div class="stat-card"><div class="label">Free beds</div><div class="value"><%= h.num(stats.free) %></div></div>
  <div class="stat-card <%= stats.unassigned ? 'gold' : '' %>"><div class="label">Boarders without a room</div>
    <div class="value"><%= h.num(stats.unassigned) %></div></div>
</div>

<div class="grid" style="grid-template-columns:1fr 330px;align-items:start;gap:1.1rem">
  <div>
    <div class="card" style="margin-bottom:1.1rem">
      <div class="card-head"><h2>Rooms</h2></div>
      <div class="card-body flush">
        <% if (rooms.length) { %>
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th>Room</th><th>Block</th><th class="num">Capacity</th><th class="num">Occupied</th><th class="num">Free</th><th class="num">Monthly fee</th><th class="actions"></th></tr></thead>
            <tbody>
              <% rooms.forEach(function (r) { var free = Number(r.capacity) - Number(r.occupied); %>
                <tr>
                  <td><strong><%= r.room_no %></strong></td>
                  <td><%= r.block || '—' %></td>
                  <td class="num"><%= r.capacity %></td>
                  <td class="num"><%= r.occupied %></td>
                  <td class="num"><span class="badge badge-<%= free > 0 ? 'green' : 'red' %>"><%= free %></span></td>
                  <td class="num"><%= money(r.monthly_fee) %></td>
                  <td class="actions">
                    <a class="btn btn-light btn-sm" href="/admin/hostel?edit=<%= r.id %>">Edit</a>
                    <form method="post" action="/admin/hostel/rooms/<%= r.id %>" style="display:inline" data-confirm="Delete room <%= r.room_no %> and its allocations?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE">
                      <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %><div class="empty"><div class="big">⌂</div><p>No rooms added yet.</p></div><% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2>Current allocations</h2></div>
      <div class="card-body flush">
        <% if (allocations.length) { %>
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th>Room</th><th>Student</th><th>Class</th><th>Since</th><th class="actions"></th></tr></thead>
            <tbody>
              <% allocations.forEach(function (a) { %>
                <tr>
                  <td><strong><%= a.room_no %></strong><%= a.block ? ' · ' + a.block : '' %></td>
                  <td><a href="/admin/students/<%= a.student_id %>"><%= a.student %></a><br><small class="sub"><%= a.admission_no %></small></td>
                  <td><%= a.class_name || '—' %></td>
                  <td><%= h.fmtDate(a.allocated_on) %></td>
                  <td class="actions">
                    <form method="post" action="/admin/hostel/allocations/<%= a.id %>/vacate" style="display:inline" data-confirm="Vacate this room?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-light btn-sm" type="submit">Vacate</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %><div class="empty"><p>Nobody is allocated a room yet.</p></div><% } %>
      </div>
    </div>
  </div>

  <div>
    <div class="card" style="margin-bottom:1.1rem">
      <div class="card-head"><h2>Allocate a room</h2></div>
      <div class="card-body">
        <% if (unassigned.length && rooms.length) { %>
          <form method="post" action="/admin/hostel/allocate">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field" style="margin-bottom:.7rem">
              <label for="student_id">Student <span class="req">*</span></label>
              <select id="student_id" name="student_id" required>
                <option value="">— Select —</option>
                <% unassigned.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %> (<%= s.admission_no %>)</option><% }); %>
              </select>
            </div>
            <div class="field" style="margin-bottom:.7rem">
              <label for="room_id">Room <span class="req">*</span></label>
              <select id="room_id" name="room_id" required>
                <option value="">— Select —</option>
                <% rooms.filter(function (r) { return Number(r.occupied) < Number(r.capacity); }).forEach(function (r) { %>
                  <option value="<%= r.id %>"><%= r.room_no %> — <%= Number(r.capacity) - Number(r.occupied) %> free</option>
                <% }); %>
              </select>
            </div>
            <div class="field" style="margin-bottom:.9rem">
              <label for="allocated_on">From</label>
              <input id="allocated_on" name="allocated_on" type="date" value="<%= h.today() %>">
            </div>
            <button class="btn btn-primary" type="submit" style="width:100%">Allocate</button>
          </form>
        <% } else if (!rooms.length) { %>
          <p class="sub">Add a room first.</p>
        <% } else { %>
          <p class="sub">Every boarding student has a room. Mark a student as a boarder on their profile to allocate one.</p>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2><%= editRoom ? 'Edit room' : 'Add room' %></h2></div>
      <div class="card-body">
        <form method="post" action="/admin/hostel/rooms">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (editRoom) { %><input type="hidden" name="id" value="<%= editRoom.id %>"><% } %>
          <div class="field" style="margin-bottom:.7rem"><label for="room_no">Room number <span class="req">*</span></label>
            <input id="room_no" name="room_no" type="text" required value="<%= editRoom ? editRoom.room_no : '' %>"></div>
          <div class="field" style="margin-bottom:.7rem"><label for="block">Block</label>
            <input id="block" name="block" type="text" value="<%= editRoom ? editRoom.block || '' : '' %>"></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-bottom:.7rem">
            <div class="field"><label for="capacity">Capacity</label>
              <input id="capacity" name="capacity" type="number" min="1" value="<%= editRoom ? editRoom.capacity : 4 %>"></div>
            <div class="field"><label for="monthly_fee">Monthly fee</label>
              <input id="monthly_fee" name="monthly_fee" type="number" step="0.01" min="0" value="<%= editRoom ? editRoom.monthly_fee : 0 %>"></div>
          </div>
          <div class="field" style="margin-bottom:.9rem"><label for="notes">Notes</label>
            <input id="notes" name="notes" type="text" value="<%= editRoom ? editRoom.notes || '' : '' %>"></div>
          <button class="btn btn-primary" type="submit"><%= editRoom ? 'Save changes' : 'Add room' %></button>
          <% if (editRoom) { %><a class="btn btn-light" href="/admin/hostel">Cancel</a><% } %>
        </form>
      </div>
    </div>
  </div>
</div>

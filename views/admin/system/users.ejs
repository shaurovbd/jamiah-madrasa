<div class="page-bar"><div><h1><%= t('admin.nav.users') %></h1><p class="sub"><%= t('a.user.sub') %></p></div></div>

<div class="grid" style="grid-template-columns:1fr 340px;align-items:start;gap:1.1rem">
  <div>
    <div class="card" style="margin-bottom:1.1rem">
      <div class="card-head"><h2><%= t('a.user.accounts') %></h2></div>
      <div class="card-body flush">
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th><%= t('common.name') %></th><th><%= t('auth.username') %></th><th><%= t('a.role') %></th><th><%= t('a.user.last_signed_in') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
            <tbody>
              <% users.forEach(function (u) { %>
                <tr>
                  <td><strong><%= u.name %></strong><% if (u.email) { %><br><small class="sub"><%= u.email %></small><% } %></td>
                  <td><%= u.username %><% if (u.id === user.id) { %> <span class="badge badge-blue"><%= t('a.user.you') %></span><% } %></td>
                  <td><span class="badge badge-<%= u.role === 'admin' ? 'green' : (u.role === 'principal' ? 'blue' : 'grey') %>"><%= label('role', u.role) %></span></td>
                  <td><%= u.last_login ? fmtDate(u.last_login) : 'Never' %></td>
                  <td><span class="badge badge-<%= u.is_active ? 'green' : 'red' %>"><%= u.is_active ? 'Active' : 'Disabled' %></span></td>
                  <td class="actions">
                    <a class="btn btn-light btn-sm" href="/admin/users?edit=<%= u.id %>"><%= t('common.edit') %></a>
                    <% if (u.id !== user.id) { %>
                      <form method="post" action="/admin/users/<%= u.id %>" style="display:inline" data-confirm="Delete the account for <%= u.name %>?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE">
                        <button class="btn btn-danger btn-sm" type="submit"><%= t('common.delete') %></button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2><%= t('a.user.roles_heading') %></h2></div>
      <div class="card-body">
        <table class="data compact">
          <thead><tr><th><%= t('a.role') %></th><th><%= t('a.user.access') %></th></tr></thead>
          <tbody>
            <% ROLES.forEach(function (r) { var roleKey = 'role.' + r, accessKey = 'a.user.role_' + r; %>
            <tr><td><strong><%= t(roleKey) %></strong></td><td><%= t(accessKey) %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div>
    <div class="card" style="margin-bottom:1.1rem">
      <div class="card-head"><h2><%= edit ? 'Edit user' : 'New user' %></h2></div>
      <div class="card-body">
        <form method="post" action="/admin/users">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (edit) { %><input type="hidden" name="id" value="<%= edit.id %>"><% } %>
          <div class="field" style="margin-bottom:.7rem"><label for="name"><%= t('a.full_name') %> <span class="req">*</span></label>
            <input id="name" name="name" type="text" required value="<%= edit ? edit.name : '' %>"></div>
          <div class="field" style="margin-bottom:.7rem"><label for="username"><%= t('auth.username') %> <span class="req">*</span></label>
            <input id="username" name="username" type="text" required autocomplete="off" value="<%= edit ? edit.username : '' %>"></div>
          <div class="field" style="margin-bottom:.7rem"><label for="email"><%= t('common.email') %></label>
            <input id="email" name="email" type="email" value="<%= edit ? edit.email || '' : '' %>"></div>
          <div class="field" style="margin-bottom:.7rem"><label for="role"><%= t('a.role') %></label>
            <select id="role" name="role">
              <% ROLES.forEach(function (r) { %><option value="<%= r %>" <%= (edit ? edit.role === r : r === 'teacher') ? 'selected' : '' %>><%= label('role', r) %></option><% }); %>
            </select></div>
          <div class="field" style="margin-bottom:.7rem">
            <label for="password"><%= t('auth.password') %> <% if (!edit) { %><span class="req">*</span><% } %></label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8">
            <span class="hint"><%= edit ? 'Leave blank to keep the current password.' : 'At least 8 characters.' %></span>
          </div>
          <% if (!edit) { %>
          <div class="field" style="margin-bottom:.7rem"><label for="staff_id"><%= t('a.user.link_staff') %></label>
            <select id="staff_id" name="staff_id"><option value=""><%= t('common.opt_none') %></option>
              <% staff.filter(function (s) { return !s.user_id; }).forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
            </select></div>
          <% } %>
          <label class="chk" style="margin-bottom:.9rem">
            <input type="checkbox" name="is_active" value="1" <%= edit ? (edit.is_active ? 'checked' : '') : 'checked' %>> <%= t('a.user.account_active') %></label>
          <div><button class="btn btn-primary" type="submit"><%= edit ? 'Save changes' : 'Create account' %></button>
          <% if (edit) { %><a class="btn btn-light" href="/admin/users"><%= t('common.cancel') %></a><% } %></div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2><%= t('a.user.change_my_password') %></h2></div>
      <div class="card-body">
        <form method="post" action="/admin/users/password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field" style="margin-bottom:.7rem"><label for="current_password"><%= t('a.user.current_password') %></label>
            <input id="current_password" name="current_password" type="password" autocomplete="current-password" required></div>
          <div class="field" style="margin-bottom:.7rem"><label for="new_password"><%= t('a.user.new_password') %></label>
            <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="8" required></div>
          <div class="field" style="margin-bottom:.9rem"><label for="confirm_password"><%= t('a.user.confirm_password') %></label>
            <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required></div>
          <button class="btn btn-light" type="submit"><%= t('a.user.change_password') %></button>
        </form>
      </div>
    </div>
  </div>
</div>

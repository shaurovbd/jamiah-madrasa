<div class="page-bar">
  <div><h1><%= t('a.exam.results') %></h1><p class="sub"><%= exam.name %><%= klass ? ' · ' + klass.name : '' %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light no-print" href="/admin/exams/<%= exam.id %>"><%= t('a.exam.back_exam') %></a>
  <% if (ranking.length) { %><button class="btn btn-light no-print" onclick="window.print()"><%= t('common.print') %></button><% } %>
</div>

<div class="card no-print" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/exams/<%= exam.id %>/results">
      <div class="field"><label for="class_id"><%= t('common.class') %> <span class="req">*</span></label>
        <select id="class_id" name="class_id" onchange="this.form.submit()" required>
          <option value=""><%= t('results.select_placeholder') %></option>
          <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
        </select></div>
      <button class="btn btn-primary" type="submit"><%= t('a.show') %></button>
    </form>
  </div>
</div>

<% if (ranking.length) { %>
  <div class="grid g4 no-print" style="margin-bottom:1.1rem">
    <div class="stat-card"><div class="label"><%= t('a.exam.appeared') %></div><div class="value"><%= ranking.length %></div></div>
    <div class="stat-card"><div class="label"><%= t('results.passed') %></div><div class="value"><%= ranking.filter(function (r) { return r.result === 'Passed'; }).length %></div></div>
    <div class="stat-card red"><div class="label"><%= t('results.failed') %></div><div class="value"><%= ranking.filter(function (r) { return r.result === 'Failed'; }).length %></div></div>
    <div class="stat-card gold"><div class="label"><%= t('a.exam.pass_rate') %></div><div class="value"><%= Math.round((ranking.filter(function (r) { return r.result === 'Passed'; }).length / ranking.length) * 100) %>%</div></div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('a.exam.merit_list') %></h2></div>
    <div class="card-body flush">
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th class="num"><%= t('a.exam.position') %></th><th><%= t('common.roll') %></th><th><%= t('common.name') %></th><th class="num"><%= t('results.obtained') %></th><th class="num"><%= t('a.full_word') %></th><th class="num">%</th><th><%= t('results.result') %></th><th class="actions no-print"></th></tr></thead>
          <tbody>
            <% ranking.forEach(function (r) { %>
              <tr>
                <td class="num"><strong><%= r.position %></strong></td>
                <td><%= r.roll_no || '—' %></td>
                <td><a href="/admin/students/<%= r.student_id %>"><%= r.name %></a></td>
                <td class="num"><%= r.total %></td>
                <td class="num"><%= r.full %></td>
                <td class="num"><%= r.percent %></td>
                <td><span class="badge badge-<%= r.result === 'Passed' ? 'green' : 'red' %>"><%= r.result %></span></td>
                <td class="actions no-print">
                  <a class="btn btn-light btn-sm" href="/admin/exams/<%= exam.id %>/marksheet/<%= r.student_id %>"><%= t('a.marksheet') %></a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } else if (filters.class_id) { %>
  <div class="card"><div class="card-body empty"><p><%= t('a.exam.no_marks_class') %>
    <a href="/admin/exams/<%= exam.id %>/marks?class_id=<%= filters.class_id %>"><%= t('a.exam.enter_marks') %></a>.</p></div></div>
<% } else { %>
  <div class="card"><div class="card-body empty"><div class="big">▤</div><p><%= t('a.exam.choose_merit') %></p></div></div>
<% } %>

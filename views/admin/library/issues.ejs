<div class="page-bar"><h1><%= t('admin.nav.library') %></h1></div>
<%- include('../../partials/tabs', { TABS: TABS, currentPath: currentPath }) %>

<div class="grid" style="grid-template-columns:1fr 330px;align-items:start;gap:1.1rem">
  <div class="card">
    <div class="card-head">
      <h2><%= t('a.lib.loans') %></h2><span class="spacer"></span>
      <form method="get" action="/admin/library/issues">
        <select name="status" onchange="this.form.submit()">
          <% ['issued','returned','lost'].forEach(function (s) { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= label('status', s) %></option>
          <% }); %>
        </select>
      </form>
    </div>
    <div class="card-body flush">
      <% if (issues.length) { %>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th><%= t('a.lib.book') %></th><th><%= t('a.lib.borrower') %></th><th><%= t('a.issued') %></th><th><%= t('a.due') %></th><th><%= t('a.lib.returned') %></th><th class="num"><%= t('a.lib.fine') %></th><th class="actions"></th></tr></thead>
          <tbody>
            <% var todayStr = h.today();
               issues.forEach(function (i) {
                 var overdue = i.status === 'issued' && String(i.due_date).slice(0,10) < todayStr; %>
              <tr>
                <td><strong><%= i.title %></strong><br><small class="sub"><%= i.book_no %></small></td>
                <td><%= i.student_name || i.staff_name || '—' %>
                  <% if (i.admission_no) { %><br><small class="sub"><%= i.admission_no %></small><% } %></td>
                <td><%= fmtDate(i.issue_date) %></td>
                <td><%= fmtDate(i.due_date) %>
                  <% if (overdue) { %><br><span class="badge badge-red"><%= t('a.lib.overdue') %></span><% } %></td>
                <td><%= i.return_date ? fmtDate(i.return_date) : '—' %></td>
                <td class="num"><%= Number(i.fine) > 0 ? money(i.fine) : '—' %></td>
                <td class="actions">
                  <% if (i.status === 'issued') { %>
                    <form method="post" action="/admin/library/issues/<%= i.id %>/return" style="display:flex;gap:.3rem;justify-content:flex-end">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="number" name="fine" step="0.01" min="0" value="0" style="width:80px" title="<%= t('a.lib.fine') %>">
                      <button class="btn btn-primary btn-sm" type="submit"><%= t('a.lib.return') %></button>
                      <button class="btn btn-danger btn-sm" type="submit" name="lost" value="1"><%= t('a.lib.lost') %></button>
                    </form>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %><div class="empty"><p><%= filters.status ? t('a.lib.no_loans_status', { status: label('status', filters.status) }) : t('a.lib.no_loans_filter') %></p></div><% } %>
    </div>
    <%- include('../../partials/pager', { p: p, query: query, h: h }) %>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('a.lib.issue_a_book') %></h2></div>
    <div class="card-body">
      <form method="post" action="/admin/library/issues">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field" style="margin-bottom:.7rem">
          <label for="book_id"><%= t('a.lib.book') %> <span class="req">*</span></label>
          <select id="book_id" name="book_id" required>
            <option value=""><%= t('results.select_placeholder') %></option>
            <% books.forEach(function (b) { %><option value="<%= b.id %>"><%= b.title %> <%= t('a.lib.available_paren', { count: b.available_copies }) %></option><% }); %>
          </select>
        </div>
        <div class="field" style="margin-bottom:.7rem">
          <label for="student_id"><%= t('results.student') %></label>
          <select id="student_id" name="student_id">
            <option value=""><%= t('common.opt_none') %></option>
            <% students.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %> (<%= s.admission_no %>)</option><% }); %>
          </select>
        </div>
        <div class="field" style="margin-bottom:.7rem">
          <label for="staff_id"><%= t('a.lib.or_staff') %></label>
          <select id="staff_id" name="staff_id">
            <option value=""><%= t('common.opt_none') %></option>
            <% staff.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
          </select>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-bottom:.9rem">
          <div class="field"><label for="issue_date"><%= t('a.issued') %></label><input id="issue_date" name="issue_date" type="date" value="<%= h.today() %>"></div>
          <div class="field"><label for="due_date"><%= t('a.due') %></label><input id="due_date" name="due_date" type="date"></div>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%"><%= t('a.lib.issue_book') %></button>
        <p class="hint" style="margin-top:.6rem"><%= t('a.lib.due_hint') %></p>
      </form>
    </div>
  </div>
</div>

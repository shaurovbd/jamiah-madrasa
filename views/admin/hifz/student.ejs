<div class="page-bar">
  <div><h1><%= student.name %></h1><p class="sub">Hifz record · <%= student.class_name || 'No class' %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/hifz/overview">← Overview</a>
  <a class="btn btn-light" href="/admin/students/<%= student.id %>">Student profile</a>
</div>

<div class="grid g4" style="margin-bottom:1.1rem">
  <div class="stat-card gold"><div class="label">Para completed</div><div class="value"><%= student.hifz_para_completed %> / 30</div></div>
  <div class="stat-card"><div class="label">Days recorded</div><div class="value"><%= h.num(summary.days || 0) %></div></div>
  <div class="stat-card"><div class="label">Lines memorised</div><div class="value"><%= h.num(summary.total_lines || 0) %></div></div>
  <div class="stat-card red"><div class="label">Weak days</div><div class="value"><%= h.num(summary.weak || 0) %></div></div>
</div>

<div class="grid" style="grid-template-columns:1fr 320px;align-items:start;gap:1.1rem">
  <div class="card">
    <div class="card-head"><h2>Daily entries</h2></div>
    <div class="card-body flush">
      <% if (entries.length) { %>
      <div class="table-wrap">
        <table class="data compact">
          <thead><tr><th>Date</th><th>Sabak</th><th class="num">Lines</th><th>Sabqi</th><th>Manzil</th><th>Rating</th><th>Teacher</th><th>Remarks</th></tr></thead>
          <tbody>
            <% entries.forEach(function (e) { %>
              <tr>
                <td style="white-space:nowrap"><%= h.fmtDate(e.pdate) %></td>
                <td><%= e.sabak_surah || '—' %><%= e.sabak_from ? ' ' + e.sabak_from + '–' + (e.sabak_to || '') : '' %></td>
                <td class="num"><%= e.sabak_lines || '—' %></td>
                <td><%= e.sabqi_para || '—' %></td>
                <td><%= e.manzil_para || '—' %></td>
                <td><span class="badge badge-<%= e.rating === 'excellent' ? 'green' : (e.rating === 'weak' ? 'red' : 'grey') %>"><%= e.rating %></span></td>
                <td><%= e.teacher_name || '—' %></td>
                <td><%= e.remarks || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %><div class="empty"><p>No Hifz entries recorded for this student yet.</p></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2>Update progress</h2></div>
    <div class="card-body">
      <form method="post" action="/admin/hifz/student/<%= student.id %>/para">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field" style="margin-bottom:.9rem">
          <label for="hifz_para_completed">Para completed (0–30)</label>
          <input id="hifz_para_completed" name="hifz_para_completed" type="number" min="0" max="30" value="<%= student.hifz_para_completed %>">
          <span class="hint">Shown on the student profile and counted in the website's huffaz figure at 30.</span>
        </div>
        <button class="btn btn-primary" type="submit">Save progress</button>
      </form>
    </div>
  </div>
</div>

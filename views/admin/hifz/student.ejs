<div class="page-bar">
  <div><h1><%= student.name %></h1><p class="sub"><%= t('a.hifz.record_of') %> <%= student.class_name || 'No class' %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/hifz/overview"><%= t('a.hifz.back_overview') %></a>
  <a class="btn btn-light" href="/admin/students/<%= student.id %>"><%= t('a.stu.profile') %></a>
</div>

<div class="grid g4" style="margin-bottom:1.1rem">
  <div class="stat-card gold"><div class="label"><%= t('a.hifz.para_completed') %></div><div class="value"><%= student.hifz_para_completed %> / 30</div></div>
  <div class="stat-card"><div class="label"><%= t('a.hifz.days_recorded') %></div><div class="value"><%= h.num(summary.days || 0) %></div></div>
  <div class="stat-card"><div class="label"><%= t('a.hifz.lines_memorised') %></div><div class="value"><%= h.num(summary.total_lines || 0) %></div></div>
  <div class="stat-card red"><div class="label"><%= t('a.hifz.weak_days') %></div><div class="value"><%= h.num(summary.weak || 0) %></div></div>
</div>

<div class="grid" style="grid-template-columns:1fr 320px;align-items:start;gap:1.1rem">
  <div class="card">
    <div class="card-head"><h2><%= t('a.hifz.daily_entries') %></h2></div>
    <div class="card-body flush">
      <% if (entries.length) { %>
      <div class="table-wrap">
        <table class="data compact">
          <thead><tr><th><%= t('common.date') %></th><th><%= t('a.hifz.sabak') %></th><th class="num"><%= t('a.hifz.lines') %></th><th><%= t('a.hifz.sabqi') %></th><th><%= t('a.hifz.manzil') %></th><th><%= t('a.hifz.rating') %></th><th><%= t('role.teacher') %></th><th><%= t('a.remarks') %></th></tr></thead>
          <tbody>
            <% entries.forEach(function (e) { %>
              <tr>
                <td style="white-space:nowrap"><%= fmtDate(e.pdate) %></td>
                <td><%= e.sabak_surah || '—' %><%= e.sabak_from ? ' ' + e.sabak_from + '–' + (e.sabak_to || '') : '' %></td>
                <td class="num"><%= e.sabak_lines || '—' %></td>
                <td><%= e.sabqi_para || '—' %></td>
                <td><%= e.manzil_para || '—' %></td>
                <td><span class="badge badge-<%= e.rating === 'excellent' ? 'green' : (e.rating === 'weak' ? 'red' : 'grey') %>"><%= label('rating', e.rating) %></span></td>
                <td><%= e.teacher_name || '—' %></td>
                <td><%= e.remarks || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %><div class="empty"><p><%= t('a.hifz.none_for_student') %></p></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t('a.hifz.update_progress') %></h2></div>
    <div class="card-body">
      <form method="post" action="/admin/hifz/student/<%= student.id %>/para">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field" style="margin-bottom:.9rem">
          <label for="hifz_para_completed"><%= t('a.hifz.para_0_30') %></label>
          <input id="hifz_para_completed" name="hifz_para_completed" type="number" min="0" max="30" value="<%= student.hifz_para_completed %>">
          <span class="hint"><%= t('a.hifz.para_hint') %></span>
        </div>
        <button class="btn btn-primary" type="submit"><%= t('a.hifz.save_progress') %></button>
      </form>
    </div>
  </div>
</div>

<div class="page-bar">
  <div>
    <h1><%= t('admin.dashboard') %></h1>
    <p class="sub"><%= fmtPeriod(period) %> · <%= site.name %></p>
  </div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/" target="_blank"><%= t('a.dash.view_site') %></a>
  <% if (can('fees')) { %>
    <a class="btn btn-primary" href="/admin/fees/generate"><%= t('a.dash.generate_invoices') %></a>
  <% } %>
</div>

<div class="grid g4" style="margin-bottom:1.1rem">
  <% if (can('students')) { %>
  <div class="stat-card">
    <div class="label"><%= t('a.dash.active_students') %></div>
    <div class="value"><%= h.num(stats.students) %></div>
    <div class="foot"><a href="/admin/students"><%= t('a.dash.manage_students') %></a></div>
  </div>
  <div class="stat-card blue">
    <div class="label"><%= t('home.stat_staff') %></div>
    <div class="value"><%= h.num(stats.staffCount) %></div>
    <div class="foot"><a href="/admin/staff"><%= t('a.dash.manage_staff') %></a></div>
  </div>
  <% } %>
  <% if (can('admissions')) { %>
  <div class="stat-card gold">
    <div class="label"><%= t('a.dash.pending_applications') %></div>
    <div class="value"><%= h.num(stats.pendingAdmissions) %></div>
    <div class="foot"><a href="/admin/admissions?status=pending"><%= t('a.dash.review_applications') %></a></div>
  </div>
  <% } %>
  <% if (can('fees')) { %>
  <div class="stat-card red">
    <div class="label"><%= t('a.dash.outstanding_dues') %></div>
    <div class="value" style="font-size:1.4rem"><%= money(stats.totalDue) %></div>
    <div class="foot"><a href="/admin/fees/dues"><%= t('admin.nav.dues') %></a></div>
  </div>
  <% } %>
</div>

<div class="grid g4" style="margin-bottom:1.3rem">
  <% if (can('attendance')) { %>
  <div class="stat-card">
    <div class="label"><%= t('a.dash.present_today') %></div>
    <div class="value"><%= h.num(stats.presentToday) %></div>
    <div class="foot"><%= h.num(stats.absentToday) %> <%= t('a.dash.absent_sep') %> <a href="/admin/attendance"><%= t('a.dash.take_attendance') %></a></div>
  </div>
  <% } %>
  <% if (can('fees')) { %>
  <div class="stat-card gold">
    <div class="label"><%= t('a.dash.billed_month') %></div>
    <div class="value" style="font-size:1.4rem"><%= money(stats.monthBilled) %></div>
    <div class="foot"><a href="/admin/fees"><%= t('admin.nav.fees') %></a></div>
  </div>
  <div class="stat-card">
    <div class="label"><%= t('a.dash.collected_month') %></div>
    <div class="value" style="font-size:1.4rem"><%= money(stats.monthCollected) %></div>
    <div class="foot"><a href="/admin/ledger"><%= t('admin.nav.ledger') %></a></div>
  </div>
  <% } %>
  <% if (can('library')) { %>
  <div class="stat-card blue">
    <div class="label"><%= t('a.dash.books_on_loan') %></div>
    <div class="value"><%= h.num(stats.booksOut) %></div>
    <div class="foot"><a href="/admin/library"><%= t('admin.nav.library') %></a></div>
  </div>
  <% } %>
</div>

<% if (charts && (charts.fees || charts.attendance || charts.hifz)) { %>
<div class="grid g2 dash-charts" style="align-items:start;margin-bottom:1.1rem">
  <% if (charts.fees) { %>
  <div class="card chart-card <%= charts.attendance || charts.hifz ? '' : 'wide' %>">
    <div class="card-head"><h2><%= t('a.dash.ch.fees') %></h2><span class="spacer"></span>
      <span class="legend"><i class="sw s2"></i><%= t('a.dash.ch.billed') %> <i class="sw s1"></i><%= t('a.dash.ch.collected') %></span></div>
    <div class="card-body">
      <% if (charts.fees.any) { %><%- charts.fees.svg %><% } else { %><div class="empty"><p><%= t('a.dash.ch.no_data') %></p></div><% } %>
      <details class="chart-table"><summary><%= t('a.dash.ch.table') %></summary>
        <table class="data compact"><thead><tr><th><%= t('a.dash.ch.month') %></th><th class="num"><%= t('a.dash.ch.billed') %></th><th class="num"><%= t('a.dash.ch.collected') %></th></tr></thead>
          <tbody><% charts.fees.rows.forEach(function (r) { %><tr><td><%= r.label %></td><td class="num"><%= money(r.billed) %></td><td class="num"><%= money(r.paid) %></td></tr><% }); %></tbody></table>
      </details>
    </div>
  </div>
  <% } %>
  <% if (charts.attendance) { %>
  <div class="card chart-card">
    <div class="card-head"><h2><%= t('a.dash.ch.attendance') %></h2><span class="spacer"></span>
      <% if (charts.attendance.avg !== null) { %><span class="sub"><%= t('a.dash.ch.avg', { pct: charts.attendance.avg }) %></span><% } %></div>
    <div class="card-body">
      <% if (charts.attendance.any) { %><%- charts.attendance.svg %><% } else { %><div class="empty"><p><%= t('a.dash.ch.no_data') %></p></div><% } %>
      <% if (charts.attendance.rows.length) { %>
      <details class="chart-table"><summary><%= t('a.dash.ch.table') %></summary>
        <table class="data compact"><thead><tr><th><%= t('common.date') %></th><th class="num"><%= t('a.dash.ch.present_pct') %></th></tr></thead>
          <tbody><% charts.attendance.rows.forEach(function (r) { %><tr><td><%= r.label %></td><td class="num"><%= r.value %>%</td></tr><% }); %></tbody></table>
      </details>
      <% } %>
    </div>
  </div>
  <% } %>
  <% if (charts.hifz) { %>
  <div class="card chart-card">
    <div class="card-head"><h2><%= t('a.dash.ch.hifz') %></h2><span class="spacer"></span>
      <span class="sub"><%= t('a.dash.ch.hifz_done', { count: charts.hifz.done }) %></span></div>
    <div class="card-body">
      <% if (charts.hifz.any) { %><%- charts.hifz.svg %><p class="hint" style="margin-top:.2rem"><%= t('a.dash.ch.hifz_axis') %></p><% } else { %><div class="empty"><p><%= t('a.dash.ch.no_data') %></p></div><% } %>
      <details class="chart-table"><summary><%= t('a.dash.ch.table') %></summary>
        <table class="data compact"><thead><tr><th><%= t('a.dash.ch.paras') %></th><th class="num"><%= t('a.dash.ch.students') %></th></tr></thead>
          <tbody><% charts.hifz.rows.forEach(function (r) { %><tr><td><%= r.label %></td><td class="num"><%= r.value %></td></tr><% }); %></tbody></table>
      </details>
    </div>
  </div>
  <% } %>
</div>
<% } %>

<div class="grid g2" style="align-items:start">
  <% if (can('students')) { %>
  <div class="card">
    <div class="card-head"><h2><%= t('a.dash.students_by_dept') %></h2></div>
    <div class="card-body">
      <% if (byDepartment.length) { %>
        <% byDepartment.forEach(function (d) { %>
          <div class="bar-row">
            <span class="name"><%= d.name %></span>
            <span class="bar-track"><span class="bar-fill" style="width:<%= Math.round((Number(d.c) / maxDept) * 100) %>%"></span></span>
            <span class="val"><%= h.num(d.c) %></span>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty"><%= t('a.ac.no_departments') %> <a href="/admin/academics"><%= t('a.dash.add_one') %></a>.</div>
      <% } %>
    </div>
  </div>

  <% } %>
  <% if (can('admissions')) { %>
  <div class="card">
    <div class="card-head">
      <h2><%= t('a.dash.recent_applications') %></h2>
      <span class="spacer"></span>
      <a class="btn btn-light btn-sm" href="/admin/admissions"><%= t('common.all') %></a>
    </div>
    <div class="card-body flush">
      <% if (recentAdmissions.length) { %>
        <div class="table-wrap">
          <table class="data compact">
            <thead><tr><th><%= t('a.no_short') %></th><th><%= t('a.adm.applicant') %></th><th><%= t('common.class') %></th><th><%= t('common.status') %></th></tr></thead>
            <tbody>
              <% recentAdmissions.forEach(function (a) { %>
                <tr>
                  <td><a href="/admin/admissions"><%= a.application_no %></a></td>
                  <td><%= a.name %></td>
                  <td><%= a.class_name || '—' %></td>
                  <td><span class="badge badge-<%= a.status === 'approved' ? 'green' : (a.status === 'rejected' ? 'red' : 'amber') %>"><%= label('status', a.status) %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %><div class="empty"><%= t('a.dash.no_applications') %></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head" >
      <h2><%= t('a.dash.recent_payments') %></h2>
      <span class="spacer"></span>
      <a class="btn btn-light btn-sm" href="/admin/fees"><%= t('common.all') %></a>
    </div>
    <div class="card-body flush">
      <% if (recentPayments.length) { %>
        <div class="table-wrap">
          <table class="data compact">
            <thead><tr><th><%= t('a.receipt') %></th><th><%= t('results.student') %></th><th><%= t('common.date') %></th><th class="num"><%= t('common.amount') %></th></tr></thead>
            <tbody>
              <% recentPayments.forEach(function (p) { %>
                <tr>
                  <td><%= p.receipt_no %></td>
                  <td><%= p.student %></td>
                  <td><%= fmtDate(p.paid_on) %></td>
                  <td class="num"><%= money(p.amount) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %><div class="empty"><%= t('a.dash.no_payments') %></div><% } %>
    </div>
  </div>
  <% } %>

  <div class="card">
    <div class="card-head">
      <h2><%= t('home.upcoming_events') %></h2>
      <span class="spacer"></span>
      <% if (can('events')) { %><a class="btn btn-light btn-sm" href="/admin/events"><%= t('a.dash.manage') %></a><% } %>
    </div>
    <div class="card-body">
      <% if (upcomingEvents.length) { %>
        <% upcomingEvents.forEach(function (e) { %>
          <div style="display:flex;gap:.8rem;padding:.5rem 0;border-bottom:1px dashed var(--a-line)">
            <div style="flex:0 0 72px;color:var(--a-muted);font-size:.84rem"><%= fmtDate(e.event_date) %></div>
            <div><strong style="color:var(--a-ink)"><%= e.title %></strong><% if (e.location) { %><br><small style="color:var(--a-muted)"><%= e.location %></small><% } %></div>
          </div>
        <% }); %>
      <% } else { %><div class="empty"><%= t('a.dash.nothing_scheduled') %></div><% } %>
      <% if (stats.unreadMessages > 0 && can('messages')) { %>
        <p style="margin-top:1rem"><a class="btn btn-gold btn-sm" href="/admin/messages"><%= stats.unreadMessages %> <%= t('a.web.unread_message') %><%= stats.unreadMessages > 1 ? 's' : '' %></a></p>
      <% } %>
    </div>
  </div>
</div>

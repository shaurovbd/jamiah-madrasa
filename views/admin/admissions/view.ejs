<div class="page-bar">
  <div><h1><%= app.name %></h1><p class="sub">Application <%= app.application_no %> · received <%= h.fmtDate(app.applied_at) %></p></div>
  <span class="spacer"></span>
  <span class="badge badge-<%= app.status === 'approved' ? 'green' : (app.status === 'rejected' ? 'red' : 'amber') %>" style="font-size:.85rem;padding:.3rem .9rem"><%= app.status %></span>
  <a class="btn btn-light" href="/admin/admissions">← All applications</a>
</div>

<div class="grid g2" style="align-items:start">
  <div class="card">
    <div class="card-head"><h2>Application details</h2></div>
    <div class="card-body">
      <dl class="kv">
        <dt>Applicant</dt><dd><strong><%= app.name %></strong></dd>
        <dt>Father's name</dt><dd><%= app.father_name || '—' %></dd>
        <dt>Mother's name</dt><dd><%= app.mother_name || '—' %></dd>
        <dt>Date of birth</dt><dd><%= app.dob ? h.fmtDate(app.dob) : '—' %></dd>
        <dt>Gender</dt><dd><%= app.gender %></dd>
        <dt>Guardian phone</dt><dd><%= app.guardian_phone %></dd>
        <dt>Email</dt><dd><%= app.email || '—' %></dd>
        <dt>Address</dt><dd><%= app.address || '—' %></dd>
        <dt>Previous institution</dt><dd><%= app.previous_institution || '—' %></dd>
        <dt>Department applied for</dt><dd><%= app.dept_name || '—' %></dd>
        <dt>Class applied for</dt><dd><%= app.class_name || '—' %></dd>
        <dt>Note from guardian</dt><dd><%= app.note || '—' %></dd>
      </dl>
    </div>
  </div>

  <div>
    <% if (app.status === 'approved' && app.student_id) { %>
      <div class="card">
        <div class="card-head"><h2>Admitted</h2></div>
        <div class="card-body">
          <p>This applicant was admitted on <%= h.fmtDate(app.processed_at) %> as <strong><%= app.admission_no %></strong>.</p>
          <a class="btn btn-primary" href="/admin/students/<%= app.student_id %>">Open student record</a>
        </div>
      </div>
    <% } else if (app.status === 'rejected') { %>
      <div class="card">
        <div class="card-head"><h2>Rejected</h2></div>
        <div class="card-body">
          <p>This application was rejected on <%= h.fmtDate(app.processed_at) %>.</p>
          <form method="post" action="/admin/admissions/<%= app.id %>/reopen">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-light" type="submit">Reopen as pending</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="card" style="margin-bottom:1.1rem">
        <div class="card-head"><h2>Approve and enrol</h2></div>
        <div class="card-body">
          <p class="sub" style="margin-bottom:1rem">Approving creates the student record and links it to this application.</p>
          <form method="post" action="/admin/admissions/<%= app.id %>/approve">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-grid two">
              <div class="field"><label for="admission_no">Admission number <span class="req">*</span></label>
                <input id="admission_no" name="admission_no" type="text" required value="<%= suggestedAdmissionNo %>"></div>
              <div class="field"><label for="roll_no">Roll number</label>
                <input id="roll_no" name="roll_no" type="text"></div>
              <div class="field"><label for="class_id">Class</label>
                <select id="class_id" name="class_id"><option value="">— None —</option>
                  <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= app.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
                </select></div>
              <div class="field"><label for="section_id">Section</label>
                <select id="section_id" name="section_id"><option value="">— None —</option>
                  <% sections.forEach(function (s) { %><option value="<%= s.id %>" data-class="<%= s.class_id %>"><%= s.name %></option><% }); %>
                </select></div>
              <div class="field"><label for="academic_year_id">Academic year</label>
                <select id="academic_year_id" name="academic_year_id"><option value="">— None —</option>
                  <% years.forEach(function (y) { %><option value="<%= y.id %>" <%= y.is_current ? 'selected' : '' %>><%= y.name %></option><% }); %>
                </select></div>
              <div class="field"><label for="admission_date">Admission date</label>
                <input id="admission_date" name="admission_date" type="date" value="<%= h.today() %>"></div>
              <div class="field full">
                <label class="chk"><input type="checkbox" name="is_resident" value="1"> Boarding (hostel) student</label></div>
            </div>
            <input type="hidden" name="department_id" value="<%= app.department_id || '' %>">
            <div class="form-actions"><button class="btn btn-primary" type="submit">Approve &amp; create student</button></div>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-body" style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
          <div><strong>Not suitable?</strong><p class="sub" style="margin:0">Mark the application as rejected. It stays on record.</p></div>
          <span class="spacer"></span>
          <form method="post" action="/admin/admissions/<%= app.id %>/reject" data-confirm="Mark this application as rejected?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-danger" type="submit">Reject</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

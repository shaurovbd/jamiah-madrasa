<div class="page-bar">
  <div><h1><%= app.name %></h1><p class="sub"><%= t('a.adm.app_received', { no: app.application_no, date: fmtDate(app.applied_at) }) %></p></div>
  <span class="spacer"></span>
  <span class="badge badge-<%= app.status === 'approved' ? 'green' : (app.status === 'rejected' ? 'red' : 'amber') %>" style="font-size:.85rem;padding:.3rem .9rem"><%= label('status', app.status) %></span>
  <a class="btn btn-light" href="/admin/admissions"><%= t('a.adm.back_all') %></a>
</div>

<div class="grid g2" style="align-items:start">
  <div class="card">
    <div class="card-head"><h2><%= t('a.adm.details') %></h2></div>
    <div class="card-body">
      <h3 class="sub-head"><%= t('results.student') %></h3>
      <dl class="kv">
        <dt><%= t('admission.f.name_bn') %></dt><dd><strong><%= app.name %></strong></dd>
        <dt><%= t('admission.f.name_en') %></dt><dd><%= app.name_en || '—' %></dd>
        <dt><%= t('a.dob') %></dt><dd><%= app.dob ? fmtDate(app.dob) : '—' %></dd>
        <dt><%= t('admission.f.gender') %></dt><dd><%= label('gender', app.gender) %></dd>
        <dt><%= t('admission.f.nationality') %></dt><dd><%= app.nationality || '—' %></dd>
        <dt><%= t('admission.f.student_mobile') %></dt><dd><%= app.student_mobile || '—' %></dd>
        <dt><%= t('common.email') %></dt><dd><%= app.email || '—' %></dd>
      </dl>

      <h3 class="sub-head"><%= t('a.adm.applied_for') %></h3>
      <dl class="kv">
        <dt><%= t('common.department') %></dt>
        <dd><%= app.department_key ? af.deptLabel(app.department_key) : (app.dept_name || '—') %></dd>
        <dt><%= t('event.campus') %></dt><dd><%= app.campus ? af.campusLabel(app.campus) : '—' %></dd>
        <dt><%= t('admission.f.target_class') %></dt><dd><%= app.target_class || app.class_name || '—' %></dd>
        <dt><%= t('admission.f.prev_inst') %></dt><dd><%= app.previous_institution || '—' %></dd>
        <dt><%= t('admission.f.prev_class') %></dt><dd><%= app.prev_class || '—' %></dd>
      </dl>

      <h3 class="sub-head"><%= t('admission.sec.parents') %></h3>
      <dl class="kv">
        <dt><%= t('a.father_name') %></dt><dd><%= app.father_name || '—' %></dd>
        <dt><%= t('admission.f.father_mobile') %></dt><dd><%= app.father_mobile || '—' %></dd>
        <dt><%= t('admission.f.father_profession') %></dt><dd><%= app.father_profession || '—' %></dd>
        <dt><%= t('admission.f.father_income') %></dt><dd><%= app.father_income || '—' %></dd>
        <dt><%= t('a.mother_name') %></dt><dd><%= app.mother_name || '—' %></dd>
        <dt><%= t('admission.f.mother_mobile') %></dt><dd><%= app.mother_mobile || '—' %></dd>
      </dl>

      <h3 class="sub-head"><%= t('admission.sec.guardian') %></h3>
      <dl class="kv">
        <dt><%= t('admission.f.guardian_name') %></dt><dd><%= app.guardian_name || '—' %></dd>
        <dt><%= t('admission.f.guardian_relation') %></dt><dd><%= app.guardian_relation || '—' %></dd>
        <dt><%= t('a.contact_phone') %></dt><dd><%= app.guardian_phone %></dd>
        <dt><%= t('admission.f.guardian_address') %></dt><dd><%= app.guardian_address || '—' %></dd>
      </dl>

      <h3 class="sub-head"><%= t('common.address') %></h3>
      <dl class="kv">
        <dt><%= t('a.att.present') %></dt><dd><%= app.address || '—' %></dd>
        <dt><%= t('a.permanent') %></dt><dd><%= af.permanentAddress(app) || '—' %></dd>
      </dl>

      <% if (app.note) { %>
        <h3 class="sub-head"><%= t('a.adm.guardian_note') %></h3>
        <p style="margin:0"><%= app.note %></p>
      <% } %>
    </div>
  </div>

  <div>
    <% if (app.status === 'approved' && app.student_id) { %>
      <div class="card">
        <div class="card-head"><h2><%= t('a.adm.admitted') %></h2></div>
        <div class="card-body">
          <p><%- t('a.adm.admitted_on', { date: h.esc(fmtDate(app.processed_at)), no: '<strong>' + h.esc(app.admission_no) + '</strong>' }) %></p>
          <a class="btn btn-primary" href="/admin/students/<%= app.student_id %>"><%= t('a.adm.open_student') %></a>
        </div>
      </div>
    <% } else if (app.status === 'rejected') { %>
      <div class="card">
        <div class="card-head"><h2><%= t('a.adm.rejected') %></h2></div>
        <div class="card-body">
          <p><%= t('a.adm.rejected_on', { date: fmtDate(app.processed_at) }) %></p>
          <form method="post" action="/admin/admissions/<%= app.id %>/reopen">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-light" type="submit"><%= t('a.adm.reopen') %></button>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="card" style="margin-bottom:1.1rem">
        <div class="card-head"><h2><%= t('a.adm.approve_enrol') %></h2></div>
        <div class="card-body">
          <p class="sub" style="margin-bottom:1rem"><%= t('a.adm.approve_hint') %></p>
          <form method="post" action="/admin/admissions/<%= app.id %>/approve">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-grid two">
              <div class="field"><label for="admission_no"><%= t('a.admission_number') %> <span class="req">*</span></label>
                <input id="admission_no" name="admission_no" type="text" required value="<%= suggestedAdmissionNo %>"></div>
              <div class="field"><label for="roll_no"><%= t('results.roll_number') %></label>
                <input id="roll_no" name="roll_no" type="text"></div>
              <div class="field"><label for="class_id"><%= t('common.class') %></label>
                <select id="class_id" name="class_id"><option value=""><%= t('common.opt_none') %></option>
                  <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= app.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
                </select></div>
              <div class="field"><label for="section_id"><%= t('common.section') %></label>
                <select id="section_id" name="section_id"><option value=""><%= t('common.opt_none') %></option>
                  <% sections.forEach(function (s) { %><option value="<%= s.id %>" data-class="<%= s.class_id %>"><%= s.name %></option><% }); %>
                </select></div>
              <div class="field"><label for="academic_year_id"><%= t('a.academic_year') %></label>
                <select id="academic_year_id" name="academic_year_id"><option value=""><%= t('common.opt_none') %></option>
                  <% years.forEach(function (y) { %><option value="<%= y.id %>" <%= y.is_current ? 'selected' : '' %>><%= y.name %></option><% }); %>
                </select></div>
              <div class="field"><label for="admission_date"><%= t('a.admission_date') %></label>
                <input id="admission_date" name="admission_date" type="date" value="<%= h.today() %>"></div>
              <div class="field full">
                <label class="chk"><input type="checkbox" name="is_resident" value="1"> <%= t('a.stu.boarder_label') %></label></div>
            </div>
            <input type="hidden" name="department_id" value="<%= app.department_id || '' %>">
            <div class="form-actions"><button class="btn btn-primary" type="submit"><%= t('a.adm.approve_button') %></button></div>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-body" style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
          <div><strong><%= t('a.adm.not_suitable') %></strong><p class="sub" style="margin:0"><%= t('a.adm.reject_hint') %></p></div>
          <span class="spacer"></span>
          <form method="post" action="/admin/admissions/<%= app.id %>/reject" data-confirm="<%= t('a.adm.confirm_reject') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-danger" type="submit"><%= t('a.adm.reject') %></button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

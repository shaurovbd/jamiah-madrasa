<div class="page-bar">
  <div><h1><%= t('a.adm.title') %></h1><p class="sub"><%= t('a.adm.subtitle') %></p></div>
</div>

<div class="grid g4" style="margin-bottom:1.1rem">
  <a class="stat-card gold" href="/admin/admissions?status=pending" style="text-decoration:none">
    <div class="label"><%= t('a.adm.pending') %></div><div class="value"><%= h.num(counts.pending || 0) %></div></a>
  <a class="stat-card" href="/admin/admissions?status=approved" style="text-decoration:none">
    <div class="label"><%= t('a.adm.approved') %></div><div class="value"><%= h.num(counts.approved || 0) %></div></a>
  <a class="stat-card red" href="/admin/admissions?status=rejected" style="text-decoration:none">
    <div class="label"><%= t('a.adm.rejected') %></div><div class="value"><%= h.num(counts.rejected || 0) %></div></a>
  <a class="stat-card blue" href="/admin/admissions" style="text-decoration:none">
    <div class="label"><%= t('a.adm.all') %></div><div class="value"><%= h.num(p.total) %></div></a>
</div>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/admissions">
      <div class="field grow"><label for="q"><%= t('common.search') %></label>
        <input id="q" name="q" type="search" placeholder="<%= t('a.adm.search_ph') %>" value="<%= filters.q %>"></div>
      <div class="field"><label for="status"><%= t('common.status') %></label>
        <select id="status" name="status">
          <option value=""><%= t('common.all') %></option>
          <% ['pending','approved','rejected'].forEach(function (s) { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= label('status', s) %></option>
          <% }); %>
        </select></div>
      <button class="btn btn-primary" type="submit"><%= t('common.filter') %></button>
      <a class="btn btn-light" href="/admin/admissions"><%= t('common.reset') %></a>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body flush">
    <% if (applications.length) { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th><%= t('a.adm.application') %></th><th><%= t('a.adm.applicant') %></th><th><%= t('a.father') %></th><th><%= t('a.adm.applied_for') %></th><th><%= t('common.phone') %></th><th><%= t('a.received') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
        <tbody>
          <% applications.forEach(function (a) { %>
            <tr>
              <td><a href="/admin/admissions/<%= a.id %>"><%= a.application_no %></a></td>
              <td><strong><%= a.name %></strong></td>
              <td><%= a.father_name || '—' %></td>
              <td><%= a.class_name || a.dept_name || '—' %></td>
              <td><%= a.guardian_phone %></td>
              <td><%= fmtDate(a.applied_at) %></td>
              <td><span class="badge badge-<%= a.status === 'approved' ? 'green' : (a.status === 'rejected' ? 'red' : 'amber') %>"><%= label('status', a.status) %></span></td>
              <td class="actions"><a class="btn btn-light btn-sm" href="/admin/admissions/<%= a.id %>"><%= t('common.open') %></a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %><div class="empty"><div class="big">✎</div><p><%= t('a.adm.none_match') %></p></div><% } %>
  </div>
  <%- include('../../partials/pager', { p: p, query: query, h: h }) %>
</div>

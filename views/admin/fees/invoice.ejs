<div class="page-bar">
  <div><h1><%= invoice.invoice_no %></h1>
    <p class="sub"><%= invoice.student %> · <%= invoice.class_name || '—' %> · <%= h.fmtPeriod(invoice.period) %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/fees">← Invoices</a>
  <a class="btn btn-light" href="/admin/students/<%= invoice.student_id %>">Student profile</a>
</div>

<div class="grid g4" style="margin-bottom:1.1rem">
  <div class="stat-card"><div class="label">Billed</div><div class="value" style="font-size:1.3rem"><%= money(invoice.total_amount) %></div></div>
  <div class="stat-card gold"><div class="label">Discount</div><div class="value" style="font-size:1.3rem"><%= money(invoice.discount) %></div></div>
  <div class="stat-card"><div class="label">Paid</div><div class="value" style="font-size:1.3rem"><%= money(invoice.paid_amount) %></div></div>
  <div class="stat-card <%= balance > 0 ? 'red' : '' %>"><div class="label">Balance</div><div class="value" style="font-size:1.3rem"><%= money(balance) %></div></div>
</div>

<div class="grid" style="grid-template-columns:1fr 340px;align-items:start;gap:1.1rem">
  <div>
    <div class="card" style="margin-bottom:1.1rem">
      <div class="card-head"><h2>Invoice items</h2><span class="spacer"></span>
        <span class="badge badge-<%= invoice.status === 'paid' ? 'green' : (invoice.status === 'partial' ? 'amber' : 'red') %>"><%= invoice.status %></span></div>
      <div class="card-body flush">
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th>Description</th><th class="num">Amount</th></tr></thead>
            <tbody>
              <% items.forEach(function (i) { %>
                <tr><td><%= i.description %></td><td class="num"><%= money(i.amount) %></td></tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr><td><strong>Total</strong></td><td class="num"><strong><%= money(invoice.total_amount) %></strong></td></tr>
              <% if (Number(invoice.discount) > 0) { %>
                <tr><td>Less discount</td><td class="num">− <%= money(invoice.discount) %></td></tr>
                <tr><td><strong>Payable</strong></td><td class="num"><strong><%= money(payable) %></strong></td></tr>
              <% } %>
            </tfoot>
          </table>
        </div>
      </div>
      <div class="card-body" style="border-top:1px solid var(--a-line)">
        <dl class="kv" style="font-size:.88rem">
          <dt>Issued</dt><dd><%= h.fmtDate(invoice.issue_date) %></dd>
          <dt>Due</dt><dd><%= invoice.due_date ? h.fmtDate(invoice.due_date) : '—' %></dd>
          <dt>Guardian phone</dt><dd><%= invoice.guardian_phone || '—' %></dd>
          <% if (invoice.note) { %><dt>Note</dt><dd><%= invoice.note %></dd><% } %>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2>Payments</h2></div>
      <div class="card-body flush">
        <% if (payments.length) { %>
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th>Receipt</th><th>Date</th><th>Method</th><th>Received by</th><th class="num">Amount</th><th class="actions"></th></tr></thead>
            <tbody>
              <% payments.forEach(function (p) { %>
                <tr>
                  <td><a href="/admin/fees/receipt/<%= p.id %>"><%= p.receipt_no %></a></td>
                  <td><%= h.fmtDate(p.paid_on) %></td>
                  <td><%= p.method %></td>
                  <td><%= p.received_by_name || '—' %></td>
                  <td class="num"><%= money(p.amount) %></td>
                  <td class="actions">
                    <a class="btn btn-light btn-sm" href="/admin/fees/receipt/<%= p.id %>">Receipt</a>
                    <form method="post" action="/admin/fees/invoice/<%= invoice.id %>/payment/<%= p.id %>" style="display:inline" data-confirm="Remove this payment of <%= money(p.amount) %>? The invoice balance will be recalculated.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE">
                      <button class="btn btn-danger btn-sm" type="submit">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %><div class="empty"><p>No payments recorded against this invoice.</p></div><% } %>
      </div>
    </div>
  </div>

  <div>
    <% if (balance > 0) { %>
      <div class="card" style="margin-bottom:1.1rem">
        <div class="card-head"><h2>Collect payment</h2></div>
        <div class="card-body">
          <form method="post" action="/admin/fees/invoice/<%= invoice.id %>/pay">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field" style="margin-bottom:.8rem">
              <label for="amount">Amount <span class="req">*</span></label>
              <input id="amount" name="amount" type="number" step="0.01" min="0.01" max="<%= balance %>" required value="<%= balance %>">
              <span class="hint">Outstanding balance <%= money(balance) %></span>
            </div>
            <div class="field" style="margin-bottom:.8rem">
              <label for="method">Method</label>
              <select id="method" name="method">
                <option value="cash">Cash</option><option value="bank">Bank</option>
                <option value="mobile">Mobile banking</option><option value="other">Other</option>
              </select>
            </div>
            <div class="field" style="margin-bottom:.8rem">
              <label for="paid_on">Date</label>
              <input id="paid_on" name="paid_on" type="date" value="<%= h.today() %>">
            </div>
            <div class="field" style="margin-bottom:.9rem">
              <label for="note">Note</label>
              <input id="note" name="note" type="text">
            </div>
            <button class="btn btn-primary" type="submit" style="width:100%">Record payment &amp; print receipt</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-success">This invoice is fully settled.</div>
    <% } %>

    <div class="card" style="margin-bottom:1.1rem">
      <div class="card-head"><h2>Discount / waiver</h2></div>
      <div class="card-body">
        <form method="post" action="/admin/fees/invoice/<%= invoice.id %>/discount">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field" style="margin-bottom:.8rem">
            <label for="discount">Discount amount</label>
            <input id="discount" name="discount" type="number" step="0.01" min="0" max="<%= invoice.total_amount %>" value="<%= invoice.discount %>">
          </div>
          <div class="field" style="margin-bottom:.9rem">
            <label for="dnote">Reason</label>
            <input id="dnote" name="note" type="text" value="<%= invoice.note || '' %>">
          </div>
          <button class="btn btn-light" type="submit">Apply discount</button>
        </form>
      </div>
    </div>

    <div class="card" style="border-color:#edc2bd">
      <div class="card-body">
        <strong style="color:#8c2016">Delete invoice</strong>
        <p class="sub">Removes the invoice and any payments recorded against it.</p>
        <form method="post" action="/admin/fees/invoice/<%= invoice.id %>" data-confirm="Delete <%= invoice.invoice_no %> and its payments? This cannot be undone.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE">
          <button class="btn btn-danger" type="submit">Delete invoice</button>
        </form>
      </div>
    </div>
  </div>
</div>

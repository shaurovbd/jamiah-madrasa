<div class="page-bar no-print">
  <div><h1><%= t('a.fee.receipt_title') %></h1><p class="sub"><%= payment.receipt_no %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/fees/invoice/<%= payment.invoice_id %>"><%= t('a.fee.back_invoice') %></a>
  <button class="btn btn-primary" onclick="window.print()"><%= t('a.fee.print_receipt') %></button>
</div>

<div class="print-sheet">
  <div class="print-head">
    <h2><%= site.name %></h2>
    <p class="muted"><%= site.address || '' %><%= site.phone ? ' · ' + site.phone : '' %></p>
    <p style="margin:.5rem 0 0;font-weight:600"><%= t('a.fee.receipt_heading') %></p>
  </div>

  <table class="data compact" style="margin-bottom:1.2rem">
    <tbody>
      <tr><th style="width:140px"><%= t('a.fee.receipt_no') %></th><td><strong><%= payment.receipt_no %></strong></td>
          <th style="width:120px"><%= t('common.date') %></th><td><%= fmtDate(payment.paid_on) %></td></tr>
      <tr><th><%= t('results.student') %></th><td><strong><%= payment.student %></strong></td>
          <th><%= t('results.admission_no') %></th><td><%= payment.admission_no %></td></tr>
      <tr><th><%= t('a.father_name') %></th><td><%= payment.father_name || '—' %></td>
          <th><%= t('common.class') %></th><td><%= payment.class_name || '—' %></td></tr>
      <tr><th><%= t('a.fee.invoice') %></th><td><%= payment.invoice_no %></td>
          <th><%= t('routine.period') %></th><td><%= fmtPeriod(payment.period) %></td></tr>
    </tbody>
  </table>

  <div class="table-wrap">
    <table class="data">
      <thead><tr><th><%= t('a.fee.head') %></th><th class="num"><%= t('common.amount') %></th></tr></thead>
      <tbody>
        <% items.forEach(function (i) { %><tr><td><%= i.description %></td><td class="num"><%= money(i.amount) %></td></tr><% }); %>
      </tbody>
      <tfoot>
        <tr><td><%= t('a.fee.invoice_total') %></td><td class="num"><%= money(payment.total_amount) %></td></tr>
        <% if (Number(payment.discount) > 0) { %><tr><td><%= t('a.fee.discount') %></td><td class="num">− <%= money(payment.discount) %></td></tr><% } %>
        <tr style="background:#f1f5f3;font-weight:600"><td><%= t('a.fee.paid_this') %></td><td class="num"><%= money(payment.amount) %></td></tr>
        <tr><td><%= t('a.fee.paid_to_date') %></td><td class="num"><%= money(payment.paid_amount) %></td></tr>
        <tr><td><strong><%= t('a.fee.balance_remaining') %></strong></td><td class="num"><strong><%= money(balance) %></strong></td></tr>
      </tfoot>
    </table>
  </div>

  <p style="margin-top:1rem;font-size:.9rem"><%= t('a.fee.method_colon') %> <strong><%= label('method', payment.method) %></strong><%= payment.note ? ' · ' + payment.note : '' %></p>

  <div style="display:flex;justify-content:space-between;margin-top:3rem;font-size:.85rem;color:var(--a-muted)">
    <div style="border-top:1px solid var(--a-line);padding-top:.4rem;width:200px;text-align:center"><%= t('a.fee.guardian_signature') %></div>
    <div style="border-top:1px solid var(--a-line);padding-top:.4rem;width:200px;text-align:center">
      <%= t('a.fee.received_by') %><br><%= payment.received_by_name || '' %></div>
  </div>
  <p style="margin-top:1.4rem;font-size:.78rem;color:var(--a-muted);text-align:center">
    <%= t('a.fee.receipt_note') %></p>
</div>

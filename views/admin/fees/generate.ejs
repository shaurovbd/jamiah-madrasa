<div class="page-bar">
  <div><h1>Generate Invoices</h1><p class="sub">Create one invoice per active student for a month</p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/fees">← Invoices</a>
</div>

<% if (result) { %>
  <div class="alert alert-success">
    <strong><%= result.created %></strong> invoice<%= result.created === 1 ? '' : 's' %> created for <%= h.fmtPeriod(result.period) %>.
    <% if (result.skipped) { %> <%= result.skipped %> student<%= result.skipped === 1 ? ' already had' : 's already had' %> an invoice for this month and <%= result.skipped === 1 ? 'was' : 'were' %> skipped.<% } %>
    <% if (result.noStructure) { %> <%= result.noStructure %> student<%= result.noStructure === 1 ? '' : 's' %> had no fee structure for their class.<% } %>
  </div>
  <p style="margin-bottom:1.3rem">
    <a class="btn btn-primary" href="/admin/fees?period=<%= result.period %>">View these invoices</a>
    <a class="btn btn-light" href="/admin/fees/structure">Adjust fee structure</a>
  </p>
<% } %>

<div class="grid g2" style="align-items:start">
  <div class="card">
    <div class="card-head"><h2>Billing run</h2></div>
    <div class="card-body">
      <form method="post" action="/admin/fees/generate">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-grid two">
          <div class="field">
            <label for="period">Month <span class="req">*</span></label>
            <input id="period" name="period" type="month" required value="<%= period %>">
          </div>
          <div class="field">
            <label for="due_date">Due date</label>
            <input id="due_date" name="due_date" type="date">
          </div>
          <div class="field full">
            <label for="class_id">Class</label>
            <select id="class_id" name="class_id">
              <option value="">All classes</option>
              <% classes.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
            </select>
          </div>
          <div class="field full">
            <label>Include besides monthly heads</label>
            <div class="chk-list">
              <label class="chk"><input type="checkbox" name="include_one_time" value="1"> One-time heads (e.g. admission fee)</label>
              <label class="chk"><input type="checkbox" name="include_annual" value="1"> Annual heads (e.g. exam fee)</label>
            </div>
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Generate invoices</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2>How this works</h2></div>
    <div class="card-body">
      <ul style="padding-left:1.1rem;color:var(--a-muted);font-size:.92rem">
        <li style="margin-bottom:.5rem">One invoice per active student per month. A student who already has an invoice for the chosen month is skipped, so running this twice is safe.</li>
        <li style="margin-bottom:.5rem">Amounts come from the fee structure of the student's class. Students in a class with no structure are reported and skipped.</li>
        <li style="margin-bottom:.5rem">A fee head whose name contains "hostel" is only billed to students marked as boarders.</li>
        <li>To change what a class pays, set it up under <a href="/admin/fees/structure">Fee Setup</a> first.</li>
      </ul>
    </div>
  </div>
</div>

<div class="page-bar">
  <div><h1><%= t('admin.nav.fee_setup') %></h1><p class="sub"><%= t('a.fee.structure_sub') %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/fees"><%= t('a.fee.back_invoices') %></a>
</div>

<div class="grid" style="grid-template-columns:1fr 330px;align-items:start;gap:1.1rem">
  <div>
    <div class="card" style="margin-bottom:1.1rem">
      <div class="card-head"><h2><%= t('a.fee.heads') %></h2></div>
      <div class="card-body flush">
        <% if (heads.length) { %>
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th><%= t('common.name') %></th><th><%= t('common.type') %></th><th class="num"><%= t('a.fee.default_amount') %></th><th><%= t('common.active') %></th><th class="actions"></th></tr></thead>
            <tbody>
              <% heads.forEach(function (f) { %>
                <tr>
                  <td><strong><%= f.name %></strong></td>
                  <td><%= label('ftype', f.ftype) %></td>
                  <td class="num"><%= money(f.amount) %></td>
                  <td><span class="badge badge-<%= f.is_active ? 'green' : 'grey' %>"><%= f.is_active ? 'Yes' : 'No' %></span></td>
                  <td class="actions">
                    <a class="btn btn-light btn-sm" href="/admin/fees/structure?edit=<%= f.id %><%= classId ? '&class_id=' + classId : '' %>"><%= t('common.edit') %></a>
                    <form method="post" action="/admin/fees/heads/<%= f.id %>" style="display:inline" data-confirm="Delete <%= f.name %>? It is removed from every class structure.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="DELETE">
                      <button class="btn btn-danger btn-sm" type="submit"><%= t('common.delete') %></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %><div class="empty"><p><%= t('a.fee.no_heads') %></p></div><% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2><%= t('a.fee.class_structure') %></h2>
        <span class="spacer"></span>
        <form method="get" action="/admin/fees/structure">
          <select name="class_id" onchange="this.form.submit()">
            <option value=""><%= t('a.fee.choose_class_ellipsis') %></option>
            <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= classId === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
          </select>
        </form>
      </div>
      <div class="card-body">
        <% if (classId && structure.length) { %>
          <form method="post" action="/admin/fees/structure">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="class_id" value="<%= classId %>">
            <p class="sub" style="margin-bottom:.9rem"><%- t('a.fee.structure_for', { cls: '<strong>' + h.esc(klass ? klass.name : '') + '</strong>' }) %></p>
            <div class="table-wrap">
              <table class="data">
                <thead><tr><th><%= t('a.fee.head') %></th><th><%= t('common.type') %></th><th class="num"><%= t('a.fee.default') %></th><th style="width:170px"><%= t('a.fee.amount_this_class') %></th></tr></thead>
                <tbody>
                  <% structure.forEach(function (s) { %>
                    <tr>
                      <td><strong><%= s.name %></strong></td>
                      <td><%= label('ftype', s.ftype) %></td>
                      <td class="num"><%= money(s.default_amount) %></td>
                      <td><input type="number" step="0.01" min="0" name="amount[id<%= s.fee_head_id %>]" value="<%= s.amount === null || s.amount === undefined ? '' : s.amount %>"></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit"><%= t('a.fee.save_structure') %></button></div>
            <p class="hint" style="margin-top:.8rem"><%= t('a.fee.hostel_note') %></p>
          </form>
        <% } else if (classId) { %>
          <div class="empty"><p><%= t('a.fee.no_active_heads') %></p></div>
        <% } else { %>
          <div class="empty"><div class="big">⚙</div><p><%= t('a.fee.choose_to_set') %></p></div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= editHead ? 'Edit fee head' : 'Add fee head' %></h2></div>
    <div class="card-body">
      <form method="post" action="/admin/fees/heads">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (editHead) { %><input type="hidden" name="id" value="<%= editHead.id %>"><% } %>
        <div class="field" style="margin-bottom:.8rem">
          <label for="name"><%= t('common.name') %> <span class="req">*</span></label>
          <input id="name" name="name" type="text" required value="<%= editHead ? editHead.name : '' %>">
        </div>
        <div class="field" style="margin-bottom:.8rem">
          <label for="ftype"><%= t('common.type') %></label>
          <select id="ftype" name="ftype">
            <% ['monthly','one_time','annual'].forEach(function (ftype) { %>
              <option value="<%= ftype %>" <%= editHead && editHead.ftype === ftype ? 'selected' : '' %>><%= label('ftype', ftype) %></option>
            <% }); %>
          </select>
        </div>
        <div class="field" style="margin-bottom:.8rem">
          <label for="amount"><%= t('a.fee.default_amount') %></label>
          <input id="amount" name="amount" type="number" step="0.01" min="0" value="<%= editHead ? editHead.amount : 0 %>">
        </div>
        <label class="chk" style="margin-bottom:.9rem">
          <input type="checkbox" name="is_active" value="1" <%= editHead ? (editHead.is_active ? 'checked' : '') : 'checked' %>> <%= t('common.active') %>
        </label>
        <div><button class="btn btn-primary" type="submit"><%= editHead ? 'Save changes' : 'Add fee head' %></button>
        <% if (editHead) { %><a class="btn btn-light" href="/admin/fees/structure"><%= t('common.cancel') %></a><% } %></div>
      </form>
    </div>
  </div>
</div>

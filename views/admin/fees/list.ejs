<div class="page-bar">
  <div><h1><%= t('admin.nav.fees') %></h1>
    <p class="sub"><%= t('a.fee.list_summary', { billed: money(totals.billed), collected: money(totals.collected), due: money(totals.billed - totals.collected) }) %></p></div>
  <span class="spacer"></span>
  <a class="btn btn-light" href="/admin/fees/dues"><%= t('admin.nav.dues') %></a>
  <a class="btn btn-primary" href="/admin/fees/generate"><%= t('a.fee.generate_title') %></a>
</div>

<div class="card" style="margin-bottom:1.1rem">
  <div class="card-body">
    <form class="filters" method="get" action="/admin/fees">
      <div class="field grow"><label for="q"><%= t('common.search') %></label>
        <input id="q" name="q" type="search" placeholder="<%= t('a.fee.search_ph') %>" value="<%= filters.q %>"></div>
      <div class="field"><label for="period"><%= t('routine.period') %></label>
        <select id="period" name="period"><option value=""><%= t('a.fee.all_months') %></option>
          <% periods.forEach(function (x) { %><option value="<%= x.period %>" <%= filters.period === x.period ? 'selected' : '' %>><%= fmtPeriod(x.period) %></option><% }); %>
        </select></div>
      <div class="field"><label for="class_id"><%= t('common.class') %></label>
        <select id="class_id" name="class_id"><option value=""><%= t('common.all') %></option>
          <% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.class_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
        </select></div>
      <div class="field"><label for="status"><%= t('common.status') %></label>
        <select id="status" name="status"><option value=""><%= t('common.all') %></option>
          <% ['unpaid','partial','paid'].forEach(function (s) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= label('status', s) %></option><% }); %>
        </select></div>
      <button class="btn btn-primary" type="submit"><%= t('common.filter') %></button>
      <a class="btn btn-light" href="/admin/fees"><%= t('common.reset') %></a>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body flush">
    <% if (invoices.length) { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th><%= t('a.fee.invoice') %></th><th><%= t('results.student') %></th><th><%= t('common.class') %></th><th><%= t('routine.period') %></th><th class="num"><%= t('a.fee.payable') %></th><th class="num"><%= t('a.paid') %></th><th class="num"><%= t('a.balance') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
        <tbody>
          <% invoices.forEach(function (i) {
               var payable = Number(i.total_amount) - Number(i.discount);
               var balance = payable - Number(i.paid_amount); %>
            <tr>
              <td><a href="/admin/fees/invoice/<%= i.id %>"><%= i.invoice_no %></a></td>
              <td><a href="/admin/students/<%= i.student_id %>"><%= i.student %></a><br><small class="sub"><%= i.admission_no %></small></td>
              <td><%= i.class_name || '—' %></td>
              <td><%= fmtPeriod(i.period) %></td>
              <td class="num"><%= money(payable) %></td>
              <td class="num"><%= money(i.paid_amount) %></td>
              <td class="num"><strong style="color:<%= balance > 0 ? '#b3261e' : '#145c3a' %>"><%= money(balance) %></strong></td>
              <td><span class="badge badge-<%= i.status === 'paid' ? 'green' : (i.status === 'partial' ? 'amber' : 'red') %>"><%= label('status', i.status) %></span></td>
              <td class="actions"><a class="btn btn-<%= i.status === 'paid' ? 'light' : 'primary' %> btn-sm" href="/admin/fees/invoice/<%= i.id %>"><%= i.status === 'paid' ? 'View' : 'Collect' %></a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <div class="empty"><div class="big">▦</div><p><%= t('a.fee.none_match') %></p>
        <a class="btn btn-primary" href="/admin/fees/generate"><%= t('a.fee.generate_this_month') %></a></div>
    <% } %>
  </div>
  <%- include('../../partials/pager', { p: p, query: query, h: h }) %>
</div>

<% if (p && p.pages > 1) { %>
  <div class="pager">
    <span><%= t('pager.showing', { from: Math.min(p.offset + 1, p.total), to: Math.min(p.offset + p.perPage, p.total), total: h.num(p.total) }) %></span>
    <span class="spacer"></span>
    <% if (p.current > 1) { %><a href="<%= h.qs(query, { page: p.current - 1 }) %>">‹ <%= t('pager.prev') %></a><% } %>
    <%
      var from = Math.max(1, p.current - 2), to = Math.min(p.pages, from + 4);
      from = Math.max(1, to - 4);
      for (var i = from; i <= to; i++) { %>
      <% if (i === p.current) { %><span class="cur"><%= i %></span>
      <% } else { %><a href="<%= h.qs(query, { page: i }) %>"><%= i %></a><% } %>
    <% } %>
    <% if (p.current < p.pages) { %><a href="<%= h.qs(query, { page: p.current + 1 }) %>"><%= t('pager.next') %> ›</a><% } %>
  </div>
<% } else if (p) { %>
  <div class="pager"><span><%= t('pager.records', { count: h.num(p.total) }) %></span></div>
<% } %>

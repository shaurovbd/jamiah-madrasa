<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= langDir %>">
<head><meta charset="utf-8">

<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' — ' + site.name : site.name %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : (site.tagline || site.name) %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<%# Noto Sans Bengali loads in both languages: the language toggle itself is
    always labelled in Bangla, so the glyphs are needed even on English pages. %>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<%- typeof style !== 'undefined' ? style : '' %>
</head>
<body>

<div class="topbar">
  <div class="wrap">
    <div class="topbar-meta">
      <% if (site.phone) { %><span>☏ <%= site.phone %></span><% } %>
      <% if (site.email) { %><span>✉ <a href="mailto:<%= site.email %>"><%= site.email %></a></span><% } %>
    </div>
    <div class="topbar-meta">
      <a href="/routine"><%= t('nav.routine') %></a>
      <a href="/results"><%= t('nav.results') %></a>
      <a href="/admin"><%= t('nav.staff_login') %></a>
      <span class="lang-switch" role="group" aria-label="<%= t('lang.label') %>">
        <% languages.forEach(function (l) { %>
          <% if (l.code === lang) { %>
            <span class="lang-opt is-on" aria-current="true"><%= l.native %></span>
          <% } else { %>
            <a class="lang-opt" href="<%= langSwitchUrl(l.code) %>" hreflang="<%= l.code %>" rel="nofollow"><%= l.native %></a>
          <% } %>
        <% }); %>
      </span>
    </div>
  </div>
</div>

<header class="masthead">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="brand-mark">ج</span>
      <span class="brand-text">
        <strong><%= site.name %></strong>
        <small><%= site.tagline ? site.tagline.slice(0, 42) : t('site.islamic_institute') %></small>
      </span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="<%= t('nav.menu') %>">☰</button>
    <nav class="main" id="mainNav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><%= t('nav.home') %></a>
      <a href="/about" class="<%= currentPath.startsWith('/about') ? 'active' : '' %>"><%= t('nav.about') %></a>
      <a href="/departments" class="<%= currentPath.startsWith('/departments') ? 'active' : '' %>"><%= t('nav.departments') %></a>
      <a href="/notices" class="<%= currentPath.startsWith('/notices') ? 'active' : '' %>"><%= t('nav.notices') %></a>
      <a href="/events" class="<%= currentPath.startsWith('/events') ? 'active' : '' %>"><%= t('nav.events') %></a>
      <a href="/gallery" class="<%= currentPath.startsWith('/gallery') ? 'active' : '' %>"><%= t('nav.gallery') %></a>
      <a href="/contact" class="<%= currentPath.startsWith('/contact') ? 'active' : '' %>"><%= t('nav.contact') %></a>
      <a href="/admission" class="nav-cta"><%= t('nav.apply_now') %></a>
    </nav>
  </div>
</header>

<main>
<%- body %>
</main>

<footer class="site">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4><%= site.name %></h4>
        <p><%= settings.about_intro || t('footer.default_intro') %></p>
      </div>
      <div>
        <h4><%= t('footer.explore') %></h4>
        <ul>
          <li><a href="/about"><%= t('footer.about_us') %></a></li>
          <li><a href="/departments"><%= t('nav.departments') %></a></li>
          <li><a href="/admission"><%= t('footer.admission') %></a></li>
          <li><a href="/results"><%= t('nav.results') %></a></li>
        </ul>
      </div>
      <div>
        <h4><%= t('footer.information') %></h4>
        <ul>
          <li><a href="/notices"><%= t('nav.notices') %></a></li>
          <li><a href="/events"><%= t('nav.events') %></a></li>
          <li><a href="/gallery"><%= t('nav.gallery') %></a></li>
          <li><a href="/contact"><%= t('nav.contact') %></a></li>
        </ul>
      </div>
      <div>
        <h4><%= t('footer.reach_us') %></h4>
        <ul>
          <% if (site.address) { %><li><%= site.address %></li><% } %>
          <% if (site.phone) { %><li><%= site.phone %></li><% } %>
          <% if (site.email) { %><li><a href="mailto:<%= site.email %>"><%= site.email %></a></li><% } %>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> <%= site.name %>. <%= t('footer.rights') %></span>
      <span><a href="/parent"><%= t('portal.footer_link') %></a> · <a href="/admin"><%= t('footer.staff_login') %></a></span>
    </div>
  </div>
</footer>

<script>
  (function () {
    var t = document.getElementById('menuToggle'), n = document.getElementById('mainNav');
    if (t && n) t.addEventListener('click', function () { n.classList.toggle('open'); });
  })();
</script>
<%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= langDir %>">
<head><meta charset="utf-8">

<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' — ' + t('admin.management') : t('admin.management') %> | <%= site.short %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/theme-tokens.css">
<link rel="stylesheet" href="/css/date-picker.css">
<link rel="stylesheet" href="/css/features.css">
<%- typeof style !== 'undefined' ? style : '' %>
</head>
<%# The Appearance settings. Named `thm` rather than `t`, which is the
    translator. %>
<% var thm = (typeof theme !== 'undefined' && theme) || {}; %>
<body style="--a-seed:<%= thm.accent || '#166049' %>;--a-seed-2:<%= thm.accent2 || '#c3952f' %>;--a-radius:<%= thm.radius || 9 %>px" data-sidebar="<%= thm.sidebar || 'gradient' %>" data-surface="<%= thm.surface || 'solid' %>" data-glow="<%= thm.glow || 'off' %>">
<%
  /* Who sees which link comes from lib/roles.js, the same map that guards
     the routes, so a link is never shown that would answer "not allowed". */
  const can = (area) => typeof canAccess === 'function' && canAccess(area);
  const any = (...areas) => areas.some(can);
  const on = (p) => currentPath === p || (p !== '/admin' && currentPath.startsWith(p)) ? 'active' : '';
%>
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="side-brand">
      <span class="mark">ج</span>
      <a href="/admin">
        <strong><%= site.short %></strong>
        <small><%= t('admin.management') %></small>
      </a>
    </div>
    <nav class="side-nav">
      <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>"><span class="ic">▣</span> <%= t('admin.dashboard') %></a>

      <% if (any('students','admissions','staff','promotion','print','sms')) { %>
      <div class="side-group"><%= t('admin.group.people') %></div>
      <% if (can('students')) { %><a href="/admin/students" class="<%= on('/admin/students') && !currentPath.startsWith('/admin/students/promote') ? 'active' : '' %>"><span class="ic">☗</span> <%= t('admin.nav.students') %></a><% } %>
      <% if (can('admissions')) { %><a href="/admin/admissions" class="<%= on('/admin/admissions') %>"><span class="ic">✎</span> <%= t('admin.nav.admissions') %></a><% } %>
      <% if (can('staff')) { %><a href="/admin/staff" class="<%= on('/admin/staff') %>"><span class="ic">☖</span> <%= t('admin.nav.staff') %></a><% } %>
      <% if (can('promotion')) { %><a href="/admin/students/promote" class="<%= on('/admin/students/promote') %>"><span class="ic">⇧</span> <%= t('admin.nav.promotion') %></a><% } %>
      <% if (can('print')) { %><a href="/admin/print" class="<%= on('/admin/print') %>"><span class="ic">⎙</span> <%= t('admin.nav.print') %></a><% } %>
      <% if (can('sms')) { %><a href="/admin/sms" class="<%= on('/admin/sms') %>"><span class="ic">✆</span> <%= t('admin.nav.sms') %></a><% } %>
      <% } %>

      <% if (any('academics','routine','attendance','exams','hifz')) { %>
      <div class="side-group"><%= t('admin.group.academics') %></div>
      <% if (can('academics')) { %><a href="/admin/academics" class="<%= on('/admin/academics') %>"><span class="ic">▤</span> <%= t('admin.nav.academics') %></a><% } %>
      <% if (can('routine')) { %><a href="/admin/routine" class="<%= on('/admin/routine') %>"><span class="ic">▦</span> <%= t('admin.nav.routine') %></a><% } %>
      <% if (can('attendance')) { %><a href="/admin/attendance" class="<%= on('/admin/attendance') %>"><span class="ic">✓</span> <%= t('admin.nav.attendance') %></a><% } %>
      <% if (can('exams')) { %><a href="/admin/exams" class="<%= on('/admin/exams') %>"><span class="ic">◈</span> <%= t('admin.nav.exams') %></a><% } %>
      <% if (can('hifz')) { %><a href="/admin/hifz" class="<%= on('/admin/hifz') %>"><span class="ic">❁</span> <%= t('admin.nav.hifz') %></a><% } %>
      <% } %>

      <% if (any('fees','finance')) { %>
      <div class="side-group"><%= t('admin.group.finance') %></div>
      <% if (can('fees')) { %>
      <a href="/admin/fees" class="<%= currentPath === '/admin/fees' || currentPath.startsWith('/admin/fees/invoice') || currentPath.startsWith('/admin/fees/generate') ? 'active' : '' %>"><span class="ic">▦</span> <%= t('admin.nav.fees') %></a>
      <a href="/admin/fees/structure" class="<%= on('/admin/fees/structure') %>"><span class="ic">⚙</span> <%= t('admin.nav.fee_setup') %></a>
      <a href="/admin/fees/dues" class="<%= on('/admin/fees/dues') %>"><span class="ic">!</span> <%= t('admin.nav.dues') %></a>
      <% } %>
      <% if (can('finance')) { %>
      <a href="/admin/ledger" class="<%= on('/admin/ledger') %>"><span class="ic">₪</span> <%= t('admin.nav.ledger') %></a>
      <a href="/admin/ledger/day-book" class="<%= on('/admin/ledger/day-book') %>"><span class="ic">▤</span> <%= t('admin.nav.daybook') %></a>
      <a href="/admin/receipts" class="<%= on('/admin/receipts') %>"><span class="ic">▭</span> <%= t('admin.nav.receipts') %></a>
      <a href="/admin/receipts/books" class="<%= on('/admin/receipts/books') %>"><span class="ic">▨</span> <%= t('admin.nav.receipt_books') %></a>
      <a href="/admin/loans" class="<%= on('/admin/loans') %>"><span class="ic">⇄</span> <%= t('admin.nav.loans') %></a>
      <a href="/admin/loans/overdue" class="<%= on('/admin/loans/overdue') %>"><span class="ic">⚠</span> <%= t('admin.nav.loans_overdue') %></a>
      <% } %>
      <% } %>

      <% if (any('finance','orphans')) { %>
      <div class="side-group"><%= t('admin.group.donation') %></div>
      <% if (can('finance')) { %>
      <a href="/admin/donors" class="<%= on('/admin/donors') %>"><span class="ic">♡</span> <%= t('admin.nav.donors') %></a>
      <a href="/admin/donors/campaigns" class="<%= on('/admin/donors/campaigns') %>"><span class="ic">◈</span> <%= t('admin.nav.campaigns') %></a>
      <a href="/admin/donors/followups" class="<%= on('/admin/donors/followups') %>"><span class="ic">☏</span> <%= t('admin.nav.followups') %></a>
      <% } %>
      <% if (can('orphans')) { %>
      <a href="/admin/orphans" class="<%= on('/admin/orphans') %>"><span class="ic">❂</span> <%= t('admin.nav.orphans') %></a>
      <a href="/admin/orphans/sponsorships" class="<%= on('/admin/orphans/sponsorships') %>"><span class="ic">⚭</span> <%= t('admin.nav.sponsorships') %></a>
      <% } %>
      <% } %>

      <% if (any('library','hostel')) { %>
      <div class="side-group"><%= t('admin.group.facilities') %></div>
      <% if (can('library')) { %><a href="/admin/library" class="<%= on('/admin/library') %>"><span class="ic">▥</span> <%= t('admin.nav.library') %></a><% } %>
      <% if (can('hostel')) { %><a href="/admin/hostel" class="<%= on('/admin/hostel') %>"><span class="ic">⌂</span> <%= t('admin.nav.hostel') %></a><% } %>
      <% } %>

      <% if (any('notices','events','gallery','pages','messages')) { %>
      <div class="side-group"><%= t('admin.group.website') %></div>
      <% if (can('notices')) { %><a href="/admin/notices" class="<%= on('/admin/notices') %>"><span class="ic">◉</span> <%= t('admin.nav.notices') %></a><% } %>
      <% if (can('events')) { %><a href="/admin/events" class="<%= on('/admin/events') %>"><span class="ic">◷</span> <%= t('admin.nav.events') %></a><% } %>
      <% if (can('gallery')) { %><a href="/admin/gallery" class="<%= on('/admin/gallery') %>"><span class="ic">▣</span> <%= t('admin.nav.gallery') %></a><% } %>
      <% if (can('pages')) { %><a href="/admin/pages" class="<%= on('/admin/pages') %>"><span class="ic">▭</span> <%= t('admin.nav.pages') %></a><% } %>
      <% if (can('messages')) { %><a href="/admin/messages" class="<%= on('/admin/messages') %>"><span class="ic">✉</span> <%= t('admin.nav.messages') %></a><% } %>
      <% } %>

      <% if (any('users','settings','logs')) { %>
      <div class="side-group"><%= t('admin.group.system') %></div>
      <% if (can('users')) { %><a href="/admin/users" class="<%= on('/admin/users') %>"><span class="ic">☘</span> <%= t('admin.nav.users') %></a><% } %>
      <% if (can('settings')) { %><a href="/admin/settings" class="<%= on('/admin/settings') %>"><span class="ic">⚙</span> <%= t('admin.nav.settings') %></a><% } %>
      <% if (can('logs')) { %><a href="/admin/logs" class="<%= on('/admin/logs') %>"><span class="ic">☰</span> <%= t('admin.nav.logs') %></a><% } %>
      <% } %>

      <div class="side-group">&nbsp;</div>
      <a href="/" target="_blank"><span class="ic">↗</span> <%= t('admin.nav.view_site') %></a>
      <a href="/logout"><span class="ic">⏻</span> <%= t('admin.nav.sign_out') %></a>
    </nav>
  </aside>

  <div class="main">
    <div class="topbar">
      <button class="sidebar-toggle" id="sideToggle" aria-label="<%= t('nav.menu') %>">☰</button>
      <span class="page-title"><%= title || t('admin.management') %></span>
      <span class="spacer"></span>
      <%# data-no-spa: a language switch has to be a full page load, so the
          in-panel navigation script leaves these links alone. %>
      <span class="lang-switch" role="group" aria-label="<%= t('lang.label') %>">
        <% languages.forEach(function (l) { %>
          <% if (l.code === lang) { %>
            <span class="lang-opt is-on" aria-current="true"><%= l.native %></span>
          <% } else { %>
            <a class="lang-opt" href="<%= langSwitchUrl(l.code) %>" hreflang="<%= l.code %>" rel="nofollow" data-no-spa><%= l.native %></a>
          <% } %>
        <% }); %>
      </span>
      <% if (user) { %>
        <span class="who"><b><%= user.name %></b><%= t('role.' + user.role) %></span>
        <span class="avatar"><%= user.name.charAt(0).toUpperCase() %></span>
      <% } %>
    </div>

    <div class="content">
      <%# A flash entry may be a packed key-and-values message, a bare
          translation key, or literal text; tflash() handles all three. %>
      <% if (flash.success && flash.success.length) { %><div class="alert alert-success"><%= flash.success.map(function (m) { return tflash(m); }).join(' ') %></div><% } %>
      <% if (flash.error && flash.error.length) { %><div class="alert alert-error"><%= flash.error.map(function (m) { return tflash(m); }).join(' ') %></div><% } %>
      <% if (flash.info && flash.info.length) { %><div class="alert alert-info"><%= flash.info.map(function (m) { return tflash(m); }).join(' ') %></div><% } %>
      <% if (typeof scope !== 'undefined' && scope && scope.limited && !scope.classIds.size) { %>
        <div class="alert alert-info"><%= t(scope.staffId ? 'a.scope.no_classes' : 'a.scope.no_staff_link') %></div>
      <% } %>
      <%- body %>
    </div>
  </div>
</div>

<script>
  (function () {
    var t = document.getElementById('sideToggle'), s = document.getElementById('sidebar');
    if (t && s) t.addEventListener('click', function () { s.classList.toggle('open'); });
    document.querySelectorAll('form[data-confirm]').forEach(function (f) {
      f.addEventListener('submit', function (e) {
        if (!window.confirm(f.getAttribute('data-confirm'))) e.preventDefault();
      });
    });
  })();
</script>
<%- typeof script !== 'undefined' ? script : '' %>
<script src="/js/theme-picker.js" defer></script>
<script src="/js/spa-nav.js" defer></script>
<script src="/js/student-form.js" defer></script>
<script src="/js/date-picker.js" defer></script>
</body>
</html>

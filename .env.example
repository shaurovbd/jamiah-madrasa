# ---------------------------------------------------------------------------
# Jamiah Scholars International — environment configuration
# On cPanel, set these in "Setup Node.js App" → Environment variables,
# not in a file. This file documents what each one is for.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# cPanel MySQL: the database and user names carry your cPanel account prefix,
# e.g. jamiah_madrasa and jamiah_madrasauser.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jamiah_madrasa
DB_USER=jamiah_madrasauser
DB_PASSWORD=
DB_POOL=5

# Any long random string. Changing it signs everyone out.
SESSION_SECRET=

# 1 when the site is served over HTTPS (it is, on this domain).
COOKIE_SECURE=1

# Used once, the first time the seed runs, to create the "admin" account.
# Set it before running `npm run setup`, then change the password in the panel.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@jamiahscholarsinternational.com

# Set to 1 only if you want sample students, staff and notices created.
SEED_DEMO=0

# The .well-known folder inside the document root. cPanel's AutoSSL writes its
# domain-validation files there, and this app owns the document root, so it has
# to keep serving them or certificate renewal fails.
WELLKNOWN_DIR=/home/jamiah/public_html/.well-known
